                format COp {
                    0x1: cincoffsetimm({{
                        using namespace gem5::CHERIRiscvISA;

                        RegIndex cs1Idx = CS1 + cap_reg::_CNullIdx;
                        RegIndex dstIdx = CD + cap_reg::_CNullIdx;
                        // IMM12 is the raw unsigned 12-bit field; it MUST be
                        // sign-extended. Without this, negative offsets (e.g.
                        // stack-frame allocation `cincoffset csp, csp, -N`) were
                        // treated as large positive values, sending csp UP out
                        // of the stack into the kernel image and corrupting
                        // every subsequent frame save/restore.
                        int64_t imm = sext<12>(IMM12);  // 12-bit signed immediate

                            DPRINTF(CheriDecode, "Incrementing offset for c%d from c%d with immediate %lld\n", dstIdx, cs1Idx, (long long)imm);

                        // Copy source capability
                        Cd = Cs1;

                            if (!Cs1.getTag()) {
                            // Even for an UNTAGGED source, CIncOffsetImm must
                            // still add the immediate to the address -- the
                            // result is simply an untagged capability (a plain
                            // pointer). Previously the immediate was skipped
                            // here, so pointer arithmetic on untagged stack
                            // capabilities (e.g. computing &localvar = cs0 + -N)
                            // returned the base address unchanged, corrupting
                            // every derived pointer. This was the root cause of
                            // the libfdt device-tree walk never advancing.
                            uint64_t new_addr = Cs1.getAddress() + imm;
                            Cd.setAddress(new_addr);
                            Cd.setTag(false);
                            xc->tcBase()->setReg(intRegClass[CD], new_addr);
                            DPRINTF(CheriDecode, "Untagged source: applied immediate %lld -> %#llx (tag cleared)\n",
                                    (long long)imm, (unsigned long long)new_addr);
                        } else {
                            uint64_t a = Cs1.getAddress();
                            CAPTYPE meta = Cs1.getMetadata();

                            // Decode bounds
                            uint64_t B_hi = meta.B;
                            uint64_t T_hi = meta.T;
                            uint64_t B_E = meta.BE;
                            uint64_t T_E = meta.TE;
                            uint64_t I_E = meta.IE;
                            
                            uint64_t E, B, T, L_carry_out, L_msb;
                            
                            if (I_E == 0) {
                                E = 0;
                                T = (T_hi << 3) | T_E;
                                B = (B_hi << 3) | B_E;
                                L_carry_out = (T < (B & 0xFFF)) ? 1 : 0;
                                L_msb = 0;
                            } else {
                                E = (T_E << 3) | B_E;
                                T = T_hi << 3;
                                B = B_hi << 3;
                                L_carry_out = (T < (B & 0xFFF)) ? 1 : 0;
                                L_msb = 1;
                            }
                            
                            uint64_t B_top2 = (B >> 12) & 0x3;
                            T |= ((B_top2 + L_carry_out + L_msb) & 0x3) << 12;
                            
                            uint64_t A_3 = (a >> (E + 11)) & 0x7;
                            uint64_t B_3 = (B >> 11) & 0x7;
                            uint64_t T_3 = (T >> 11) & 0x7;
                            uint64_t R = (B_3 - 1) & 0x7;
                            
                            int64_t c_b;
                            bool cond1_b = (A_3 < R);
                            bool cond2_b = (B_3 < R);
                            if (!cond1_b && !cond2_b) c_b = 0;
                            else if (!cond1_b && cond2_b) c_b = 1;
                            else if (cond1_b && !cond2_b) c_b = -1;
                            else c_b = 0;
                            
                            int64_t c_t;
                            bool cond1_t = (A_3 < R);
                            bool cond2_t = (T_3 < R);
                            if (!cond1_t && !cond2_t) c_t = 0;
                            else if (!cond1_t && cond2_t) c_t = 1;
                            else if (cond1_t && !cond2_t) c_t = -1;
                            else c_t = 0;
                            
                            uint64_t a_top = (a >> (E + 14));
                            uint64_t base = ((a_top + c_b) << (E + 14)) | (B << E);
                            uint64_t top = ((a_top + c_t) << (E + 14)) | (T << E);
                            
                            // Increment address by immediate (signed)
                            uint64_t new_addr = a + imm;
                            
                            // Check bounds
                            // if (new_addr < base || new_addr >= top) {
                            //     Cd.setTag(false);
                            //     DPRINTF(CheriDecode, "New address %#llx out of bounds, clearing tag\n", (unsigned long long)new_addr);
                            // } else {
                            //     Cd.setAddress(new_addr);
                            //     DPRINTF(CheriDecode, "Incremented address by %lld to %#llx\n", (long long)imm, (unsigned long long)new_addr);
                            // }

                            Cd.setAddress(new_addr);
                                    DPRINTF(CheriDecode, "Incremented address (bounds check skipped) by %lld to %#llx\n",
                                            (long long)imm,
                                            (unsigned long long)new_addr);

                             xc->tcBase()->setReg(intRegClass[CD], new_addr);
                        }
                    }});
                } 

                format COp {
                    0x2: csetboundsimm({{
                        using namespace gem5::CHERIRiscvISA;

                        RegIndex cs1Idx = CS1 + cap_reg::_CNullIdx;
                        RegIndex dstIdx = CD + cap_reg::_CNullIdx;
                        uint64_t imm = IMM12 & 0xFFF;  // 12-bit unsigned immediate

                            DPRINTF(CheriDecode, "Setting bounds for c%d from c%d with immediate length %llu\n", dstIdx, cs1Idx, (unsigned long long)imm);

                        // Copy source capability
                        Cd = Cs1;
                        
                        if (!Cs1.getTag()) {
                            // Bring-up: stack caps are untagged (csp is a bare pointer), so
                            // &local = csetbounds(untagged stack ptr, N) would otherwise get
                            // no bounds. Apply the requested bounds so cgetlen()/cgetbase()
                            // report them (the kernel validates &local via cgetlen); keep the
                            // tag cleared.
                            {
                                bool _uex = false;
                                CAPTYPE _um = cc128EncodeBounds(Cs1.getMetadata(),
                                    Cs1.getAddress(), (uint64_t)(imm), &_uex);
                                Cd.setMetadata(_um);
                                Cd.setAddress(Cs1.getAddress());
                                (void)_uex;
                            }
                            Cd.setTag(false);
                        } else {
                            uint64_t new_base = Cs1.getAddress();
                            uint64_t req_length = imm;
                            uint64_t new_top = new_base + req_length;
                            
                            // Get original bounds to check if new bounds fit
                            uint64_t a = Cs1.getAddress();
                            CAPTYPE meta = Cs1.getMetadata();
                            
                            uint64_t B_hi = meta.B;
                            uint64_t T_hi = meta.T;
                            uint64_t B_E = meta.BE;
                            uint64_t T_E = meta.TE;
                            uint64_t I_E = meta.IE;
                            
                            // Decode original bounds
                            uint64_t E, B, T, L_carry_out, L_msb;
                            
                            if (I_E == 0) {
                                E = 0;
                                T = (T_hi << 3) | T_E;
                                B = (B_hi << 3) | B_E;
                                L_carry_out = (T < (B & 0xFFF)) ? 1 : 0;
                                L_msb = 0;
                            } else {
                                E = (T_E << 3) | B_E;
                                T = T_hi << 3;
                                B = B_hi << 3;
                                L_carry_out = (T < (B & 0xFFF)) ? 1 : 0;
                                L_msb = 1;
                            }
                            
                            uint64_t B_top2 = (B >> 12) & 0x3;
                            T |= ((B_top2 + L_carry_out + L_msb) & 0x3) << 12;
                            
                            uint64_t A_3 = (a >> (E + 11)) & 0x7;
                            uint64_t B_3 = (B >> 11) & 0x7;
                            uint64_t T_3 = (T >> 11) & 0x7;
                            uint64_t R = (B_3 - 1) & 0x7;
                            
                            // Calculate base correction
                            int64_t c_b;
                            bool cond1_b = (A_3 < R);
                            bool cond2_b = (B_3 < R);
                            if (!cond1_b && !cond2_b) c_b = 0;
                            else if (!cond1_b && cond2_b) c_b = 1;
                            else if (cond1_b && !cond2_b) c_b = -1;
                            else c_b = 0;
                            
                            // Calculate top correction
                            int64_t c_t;
                            bool cond1_t = (A_3 < R);
                            bool cond2_t = (T_3 < R);
                            if (!cond1_t && !cond2_t) c_t = 0;
                            else if (!cond1_t && cond2_t) c_t = 1;
                            else if (cond1_t && !cond2_t) c_t = -1;
                            else c_t = 0;
                            
                            uint64_t a_top = (a >> (E + 14));
                            uint64_t orig_base = ((a_top + c_b) << (E + 14)) | (B << E);
                            uint64_t orig_top = ((a_top + c_t) << (E + 14)) | (T << E);
                            
                            // Check if new bounds are within original bounds
                            if (new_base < orig_base || new_top > orig_top) {
                                Cd.setTag(false);
                                DPRINTF(CheriDecode, "New bounds out of range, clearing tag\n");
                            } else {
                                // Calculate exponent E needed for compression
                                // Immediate is only 12 bits, so max value is 4096, which fits in 14 bits
                                // Therefore E will always be 0 for immediate values
                                // CC128 bounds compression (regs/cc128_bounds.hh): smallest
                                // exponent that decodes back to exactly [base, base+len), else
                                // the tightest covering encoding. Consistent with cget* decode.
                                bool _exact = false;
                                CAPTYPE new_meta =
                                    cc128EncodeBounds(meta, new_base, req_length, &_exact);
                                uint64_t new_E = new_meta.IE ?
                                    ((uint64_t)((new_meta.TE << 3) | new_meta.BE)) : 0;
                                (void)_exact; (void)new_E;
                                
                                Cd.setMetadata(new_meta);
                                Cd.setAddress(new_base);

                                DPRINTF(CheriDecode, "Set bounds: base = %#llx, length = %llu\n", (unsigned long long)new_base, (unsigned long long)req_length);
                                xc->tcBase()->setReg(intRegClass[CD], new_base);
                            }
                        }
                    }});
                } 
            }

        0x18: decode FUNCT3 {
            format BOp {
                0x0: beq({{
                    if (rvSext(Rs1) == rvSext(Rs2)) {
                        NPC = rvZext(PC + imm);
                    } else {
                        NPC = rvZext(NPC);
                    }
                }}, IsDirectControl, IsCondControl);
                0x1: bne({{
                    if (rvSext(Rs1) != rvSext(Rs2)) {
                        NPC = rvZext(PC + imm);
                    } else {
                        NPC = rvZext(NPC);
                    }
                }}, IsDirectControl, IsCondControl);
                0x4: blt({{
                    if (rvSext(Rs1_sd) < rvSext(Rs2_sd)) {
                        NPC = rvZext(PC + imm);
                    } else {
                        NPC = rvZext(NPC);
                    }
                }}, IsDirectControl, IsCondControl);
                0x5: bge({{
                    if (rvSext(Rs1_sd) >= rvSext(Rs2_sd)) {
                        NPC = rvZext(PC + imm);
                    } else {
                        NPC = rvZext(NPC);
                    }
                }}, IsDirectControl, IsCondControl);
                0x6: bltu({{
                    if (rvZext(Rs1) < rvZext(Rs2)) {
                        NPC = rvZext(PC + imm);
                    } else {
                        NPC = rvZext(NPC);
                    }
                }}, IsDirectControl, IsCondControl);
                0x7: bgeu({{
                    if (rvZext(Rs1) >= rvZext(Rs2)) {
                        NPC = rvZext(PC + imm);
                    } else {
                        NPC = rvZext(NPC);
                    }
                }}, IsDirectControl, IsCondControl);
            }
        }

        0x19: decode FUNCT3 {
            0x0: Jump::jalr({{
                // Rd = rvSext(NPC);
                // NPC = rvZext((imm + Rs1) & (~0x1));

                using namespace gem5::CHERIRiscvISA;

                DPRINTF(CheriDecode, "JALR.CAP: cd=c%d cs1=c%d\n",
                        CD + cap_reg::_CNullIdx, CS1 + cap_reg::_CNullIdx);

                // ── Capture Cs1 FIRST, before any writes to Cd ──
                // Cd and Cs1 may name the same register (common case: jalr cra, 0(cra))
                CapRegContainer _jalr_target = Cs1;

                if (!_jalr_target.getTag()) {
                    // tag violation
                } else {
                    PCState pc_state;
                    set(pc_state, xc->pcState());
                    CapRegContainer current_pcc = pc_state.pcc();

                    // ── Compute target address ──
                    uint64_t target = (_jalr_target.getAddress() + imm) & ~1ULL;

                    // ── Build return capability (sentry-sealed PCC at NPC) ──
                    CapRegContainer _ret = current_pcc;
                    CAPTYPE meta = current_pcc.getMetadata();
                    meta.otype = (1ULL << 18) - 2;
                    _ret.setMetadata(meta);
                    _ret.setAddress(pc_state.npc());

                    // ── Build new PCC (from saved _jalr_target, unsealed if sentry) ──
                    CapRegContainer new_pcc = _jalr_target;
                    new_pcc.setAddress(target);
                    meta = new_pcc.getMetadata();
                    if (meta.otype == ((1ULL << 18) - 2)) {
                        meta.otype = (1ULL << 18) - 1;
                        new_pcc.setMetadata(meta);
                    }

                    // ── Now write back ──
                    Cd = _ret;
                    pc_state.pcc(new_pcc);
                    pc_state.set(target);
                    // FIX: must also set npc == target. Without this, set()
                    // leaves npc = target+4, so the CPU advances past the
                    // first instruction of the callee (skipping its prologue,
                    // e.g. the `csp -= N` frame setup) -> stack corruption and
                    // a bad return. Matches the working c_jalr/jalr_cap path.
                    pc_state.npc(target);
                    xc->pcState(pc_state);

                    DPRINTF(CheriDecode, "JALR.CAP: target=0x%x ret_addr=0x%x\n",
                            target, pc_state.npc());
                }
            }}, IsIndirectControl, IsUncondControl);
        }

        0x1b: JOp::jal({{
            Rd = rvSext(NPC);
            NPC = rvZext(PC + imm);
        }}, IsDirectControl, IsUncondControl);

        0x1c: decode FUNCT3 {
            format SystemOp {
                0x0: decode FUNCT7 {
                    0x0: decode RS2 {
                        0x0: ecall({{
                            using namespace gem5::CHERIRiscvISA;
                            CHERIPrivilegeMode prv = (CHERIPrivilegeMode)xc
                                    ->readMiscReg(MISCREG_PRV);
                            if (prv == PRV_U) {
                                // User-mode ecall -> real syscall: trap into
                                // the kernel's handler as usual.
                                return std::make_shared<SyscallFault>(prv);
                            }
                            // Supervisor/Machine ecall -> SBI call. We have no
                            // M-mode firmware (OpenSBI), so emulate the SBI in
                            // gem5 and resume at the next instruction (ecall is
                            // not IsControl, so the PC auto-advances on NoFault).
                            handleSbiEcall(xc->tcBase());
                            return NoFault;
                        }}, IsSerializeAfter, IsNonSpeculative, IsSyscall,
                            No_OpClass);
                        0x1: ebreak({{
                            return executeEBreakOrSemihosting(xc);
                        }}, IsSerializeAfter, IsNonSpeculative, No_OpClass);
                        0x2: uret({{
                           MISA misa = xc->readMiscReg(MISCREG_ISA);
                            if (!misa.rvn) {
                                return std::make_shared<IllegalInstFault>(
                                    "sret can't execute without N systems",
                                    machInst);
                            }
                            STATUS status = xc->readMiscReg(MISCREG_STATUS);
                            status.uie = status.upie;
                            status.upie = 1;
                            xc->setMiscReg(MISCREG_STATUS, status);
                            NPC = xc->readMiscReg(MISCREG_UEPC);
                        }}, IsSerializeAfter, IsNonSpeculative, IsReturn);
                    }
                    0x8: decode RS2 {
                        0x2: sret({{
                                MISA misa = xc->readMiscReg(MISCREG_ISA);
                                if (!misa.rvs) {
                                    return std::make_shared<IllegalInstFault>(
                                                "sret can't execute without RVS",
                                                machInst);
                                }
                                STATUS status = xc->readMiscReg(MISCREG_STATUS);
                                auto pm = (CHERIPrivilegeMode)xc->readMiscReg(MISCREG_PRV);
                                if (pm == PRV_U ||
                                    (pm == PRV_S && status.tsr == 1)) {
                                    return std::make_shared<IllegalInstFault>(
                                                "sret in user mode or TSR enabled",
                                                machInst);
                                }

                                using namespace gem5::CHERIRiscvISA;

                                xc->setMiscReg(MISCREG_PRV, status.spp);
                                status.sie = status.spie;
                                status.spie = 1;
                                status.spp = PRV_U;
                                xc->setMiscReg(MISCREG_STATUS, status);

                                // ── CHERI: restore PCC from SEPCC ──
                                auto *isa = dynamic_cast<ISA*>(xc->tcBase()->getIsaPtr());
                                CapRegContainer sepcc = isa->readCapMiscReg(MISCREG_SEPCC);

                                PCState pc_state;
                                set(pc_state, xc->pcState());
                                pc_state.pcc(sepcc);
                                pc_state.set(sepcc.getAddress());
                                xc->pcState(pc_state);

                                NPC = sepcc.getAddress();
                        }}, IsSerializeAfter, IsNonSpeculative, IsReturn);
                        0x5: wfi({{
                            MISA misa = xc->readMiscReg(MISCREG_ISA);
                            STATUS status = xc->readMiscReg(MISCREG_STATUS);
                            auto pm = (CHERIPrivilegeMode)xc->readMiscReg(
                                MISCREG_PRV);
                            if (misa.rvs && (pm == PRV_U ||
                                (pm == PRV_S && status.tw == 1))) {
                                return std::make_shared<IllegalInstFault>(
                                            "wfi in user mode or TW enabled",
                                            machInst);
                            }
                            // Go to sleep only if there's no pending interrupt
                            // at all, including masked interrupts.
                            auto tc = xc->tcBase();
                            auto cpu = tc->getCpuPtr();
                            auto ic = dynamic_cast<CHERIRiscvISA::Interrupts*>(
                                cpu->getInterruptController(tc->threadId()));
                            panic_if(!ic, "Invalid Interrupt Controller.");
                            if (ic->readIP() == 0
                                && xc->readMiscReg(MISCREG_NMIP) == 0) {
                                tc->quiesce();
                            }
                        }}, IsNonSpeculative, IsQuiesce,
                            IsSerializeAfter, No_OpClass, IsSquashAfter);
                    }
                    0x9: sfence_vma({{
                        MISA misa = xc->readMiscReg(MISCREG_ISA);
                        if (!misa.rvs) {
                            return std::make_shared<IllegalInstFault>(
                                "sfence_vma can't execute without RVS",
                                machInst);
                        }
                        STATUS status = xc->readMiscReg(MISCREG_STATUS);
                        auto pm = (CHERIPrivilegeMode)xc->
                                readMiscReg(MISCREG_PRV);
                        if (pm == PRV_U || (pm == PRV_S && status.tvm == 1)) {
                            return std::make_shared<IllegalInstFault>(
                                        "sfence in user mode or TVM enabled",
                                        machInst);
                        }
                        xc->tcBase()->getMMUPtr()->demapPage(Rs1, Rs2);
                    }}, IsNonSpeculative, IsSerializeAfter, No_OpClass);
                    0x18: mret({{
                        if (xc->readMiscReg(MISCREG_PRV) != PRV_M) {
                            return std::make_shared<IllegalInstFault>(
                                        "mret at lower privilege", machInst);
                        }

                        using namespace gem5::CHERIRiscvISA;

                        // Restore privilege state
                        STATUS status = xc->readMiscReg(MISCREG_STATUS);
                        xc->setMiscReg(MISCREG_PRV, status.mpp);
                        xc->setMiscReg(MISCREG_NMIE, 1);
                        status.mie = status.mpie;
                        status.mpie = 1;
                        status.mpp = PRV_U;
                        xc->setMiscReg(MISCREG_STATUS, status);

                        // ── CHERI: restore PCC from MEPCC ──
                        auto *isa = dynamic_cast<ISA*>(xc->tcBase()->getIsaPtr());
                        CapRegContainer mepcc = isa->readCapMiscReg(MISCREG_MEPCC);

                        PCState pc_state;
                        set(pc_state, xc->pcState());
                        pc_state.pcc(mepcc);
                        pc_state.set(mepcc.getAddress());
                        xc->pcState(pc_state);

                        NPC = mepcc.getAddress();
                    }}, IsSerializeAfter, IsNonSpeculative, IsReturn);
                }
            }
            format CSROp {
                0x1: csrrw({{
                    Rd = rvSext(data);
                    data = rvZext(Rs1);
                }}, 'RD != 0', 'true'
                  , IsSerializeAfter, IsNonSpeculative, No_OpClass);
                0x2: csrrs({{
                    Rd = rvSext(data);
                    data = rvZext(data | Rs1);
                }}, 'true', 'RS1 != 0'
                  , IsSerializeAfter, IsNonSpeculative, No_OpClass);
                0x3: csrrc({{
                    Rd = rvSext(data);
                    data = rvZext(data & ~Rs1);
                }}, 'true', 'RS1 != 0'
                  , IsSerializeAfter, IsNonSpeculative, No_OpClass);
                0x5: csrrwi({{
                    Rd = rvSext(data);
                    data = rvZext(uimm);
                }}, 'RD != 0', 'true'
                  , IsSerializeAfter, IsNonSpeculative, No_OpClass);
                0x6: csrrsi({{
                    Rd = rvSext(data);
                    data = rvZext(data | uimm);
                }}, 'true', 'uimm != 0'
                  , IsSerializeAfter, IsNonSpeculative, No_OpClass);
                0x7: csrrci({{
                    Rd = rvSext(data);
                    data = rvZext(data & ~uimm);
                }}, 'true', 'uimm != 0'
                  , IsSerializeAfter, IsNonSpeculative, No_OpClass);
            }
        }

        0x1e: M5Op::M5Op();
    }
}
