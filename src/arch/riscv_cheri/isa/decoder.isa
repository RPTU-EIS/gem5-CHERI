                            if (tags_equal && addrs_equal && meta_equal) {
                                Rd = 1;
                                DPRINTF(CheriDecode, "Capabilities are exactly equal\n");
                            } else {
                                Rd = 0;
                                DPRINTF(CheriDecode, "Capabilities are NOT equal (tag=%d, addr=%d, meta=%d)\n",
                                        (int)tags_equal, (int)addrs_equal, (int)meta_equal);
                            }
                        }});
                    } 

                    format COp {
                        0x7f: decode CAPFUN {
                        0x00: cgetperm({{
                            using namespace gem5::CHERIRiscvISA;

                            RegIndex cs1Idx    = CS1 + cap_reg::_CNullIdx;
                            RegIndex dstIdx    = RD + int_reg::_ZeroIdx;

                                DPRINTF(CheriDecode, "Getting permissions for c%d and storing in x%d\n",
                                    cs1Idx, dstIdx);

                            CAPTYPE meta = Cs1.getMetadata();

                            // ── CHERI-RISC-V user-perm layout ──
                            // Architecturally CGetPerm returns arch perms at 0-11 and
                            // the four user perms SW0..SW3 at bits 15,16,17,18
                            // (SW0/15=syscall, SW1/16=SW_VMEM, ...). Our 16-bit stored
                            // perm field can't hold bits 16-18, so we pack SW1/SW2/SW3
                            // into the otherwise-unused stored bits 12/13/14 and keep
                            // SW0 at stored bit 15. Expand back to the architectural
                            // layout here: stored 12/13/14 -> out 16/17/18.
                            uint64_t stored = (uint64_t)meta.perm;
                            uint64_t out = (stored & 0x8FFFULL) |
                                           ((stored & 0x7000ULL) << 4);
                            Rd = out;

                                DPRINTF(CheriDecode, "The permissions (stored=%#llx) = %#llx\n",
                                    (unsigned long long)stored, (unsigned long long)out);
                        }});

                        0x01: cgettype({{
                            // Haven't taken care of the reserved otype
                            // Did not understand what it was 

                            using namespace gem5::CHERIRiscvISA;

                            RegIndex cs1Idx    = CS1 + cap_reg::_CNullIdx;
                            RegIndex dstIdx    = RD + int_reg::_ZeroIdx;

                                DPRINTF(CheriDecode, "Getting otype for c%d and storing in x%d\n",
                                    cs1Idx, dstIdx);

                            CAPTYPE meta = Cs1.getMetadata();
                            
                            Rd = meta.otype;

                                DPRINTF(CheriDecode, "The otype value = %#llx\n",
                                    (unsigned long long)meta.otype);
                        }});

                        0x02: cgetbase({{

                            using namespace gem5::CHERIRiscvISA;

                            RegIndex cs1Idx = CS1 + cap_reg::_CNullIdx;
                            RegIndex dstIdx = RD + int_reg::_ZeroIdx;


                            DPRINTF(CheriDecode, "CGetBase: c%d -> x%d\n", cs1Idx, dstIdx);
                            // DPRINTF(CheriDecode, "Getting base for c%d and storing in x%d\n", cs1Idx, dstIdx);

                            if (false /* bring-up: decode untagged caps too (stack caps are untagged) */) {
                                Rd = 0;
                                DPRINTF(CheriDecode, "Capability is invalid, base = 0\n");
                            } else {
                                uint64_t a = Cs1.getAddress();
                                CAPTYPE meta = Cs1.getMetadata();
                                
                                // Extract fields from capability
                                uint64_t B_hi = meta.B;      // B[13:3] - 11 bits
                                uint64_t T_hi = meta.T;      // T[11:3] - 9 bits
                                uint64_t B_E = meta.BE;      // B_E - 3 bits
                                uint64_t T_E = meta.TE;      // T_E - 3 bits
                                uint64_t I_E = meta.IE;      // I_E - 1 bit
                                
                                // Reconstruct full B and T based on I_E
                                uint64_t E, B, T, L_carry_out, L_msb;
                                
                                if (I_E == 0) {
                                    E = 0;
                                    T = (T_hi << 3) | T_E;  // T[11:3] | T[2:0]
                                    B = (B_hi << 3) | B_E;  // B[13:3] | B[2:0]
                                    L_carry_out = (T < (B & 0xFFF)) ? 1 : 0;
                                    L_msb = 0;
                                } else {
                                    E = (T_E << 3) | B_E;   // {T_E, B_E}
                                    T = T_hi << 3;          // T[11:3] | 0
                                    B = B_hi << 3;          // B[13:3] | 0
                                    L_carry_out = (T < (B & 0xFFF)) ? 1 : 0;
                                    L_msb = 1;
                                }
                                
                                // Reconstruct T[13:12]
                                uint64_t B_top2 = (B >> 12) & 0x3;
                                T |= ((B_top2 + L_carry_out + L_msb) & 0x3) << 12;
                                
                                // Calculate corrections c_b using truth table
                                uint64_t A_3 = (a >> (E + 11)) & 0x7;
                                uint64_t B_3 = (B >> 11) & 0x7;
                                uint64_t T_3 = (T >> 11) & 0x7;
                                uint64_t R = (B_3 - 1) & 0x7;
                                
                                int64_t c_b;
                                bool cond1 = (A_3 < R);
                                bool cond2 = (B_3 < R);
                                
                                if (!cond1 && !cond2) {
                                    c_b = 0;
                                } else if (!cond1 && cond2) {
                                    c_b = 1;
                                } else if (cond1 && !cond2) {
                                    c_b = -1;
                                } else { // cond1 && cond2
                                    c_b = 0;
                                }
                                
                                // Decode base
                                uint64_t a_top = (a >> (E + 14));
                                uint64_t base = ((a_top + c_b) << (E + 14)) | (B << E);
                                
                                Rd = base;
                                
                                DPRINTF(CheriDecode, "The base = %#llx\n", (unsigned long long)base);
                            }

                        }});

                        0x03: cgetlen({{

                            using namespace gem5::CHERIRiscvISA;

                            RegIndex cs1Idx = CS1 + cap_reg::_CNullIdx;
                            RegIndex dstIdx = RD + int_reg::_ZeroIdx;

                                DPRINTF(CheriDecode, "Getting length for c%d and storing in x%d\n",
                                    cs1Idx, dstIdx);

                            if (false /* bring-up: decode untagged caps too (stack caps are untagged) */) {
                                Rd = 0;
                                DPRINTF(CheriDecode, "Capability is invalid, length = 0\n");
                            } else if (!Cs1.getTag() &&
                                       (uint64_t)Cs1.getMetadata() == 0 &&
                                       Cs1.getAddress() != 0) {
                                // ── Bring-up: null-derived "integer pointer" ──
                                // cincoffset(cnull, VA) yields an UNTAGGED cap with
                                // null bounds (metadata==0) but a non-zero address.
                                // The kernel uses this as a hint address passed to
                                // vm_map_fixed, which rejects it if cgetlen(addr) <
                                // mapping_len. An unbounded integer pointer conceptually
                                // spans the address space, so report a large length so
                                // the reservation-size check passes (otherwise the map
                                // fails, the out-param slot stays uninitialised, and its
                                // stale value became a bogus kernel-address AT_TIMEKEEP
                                // that faulted rtld). Narrow: only null-bounds untagged
                                // caps -- csetbounds-derived untagged caps have meta!=0.
                                Rd = ~0ULL;
                                DPRINTF(CheriDecode, "Null-derived integer pointer "
                                        "(untagged, addr=%#llx): length = MAX\n",
                                        (unsigned long long)Cs1.getAddress());
                            } else {
                                uint64_t a = Cs1.getAddress();
                                CAPTYPE meta = Cs1.getMetadata();

                                // Extract and reconstruct fields (same as cgetbase)
                                uint64_t B_hi = meta.B;
                                uint64_t T_hi = meta.T;
                                uint64_t B_E = meta.BE;
                                uint64_t T_E = meta.TE;
                                uint64_t I_E = meta.IE;
                                
                                uint64_t E, B, T, L_carry_out, L_msb;
                                
                                if (I_E == 0) {
                                    E = 0;
                                    T = (T_hi << 3) | T_E;
                                    B = (B_hi << 3) | B_E;
                                    L_carry_out = (T < (B & 0xFFF)) ? 1 : 0;
                                    L_msb = 0;
                                } else {
                                    E = (T_E << 3) | B_E;
                                    T = T_hi << 3;
                                    B = B_hi << 3;
                                    L_carry_out = (T < (B & 0xFFF)) ? 1 : 0;
                                    L_msb = 1;
                                }
                                
                                uint64_t B_top2 = (B >> 12) & 0x3;
                                T |= ((B_top2 + L_carry_out + L_msb) & 0x3) << 12;
                                
                                // Calculate corrections
                                uint64_t A_3 = (a >> (E + 11)) & 0x7;
                                uint64_t B_3 = (B >> 11) & 0x7;
                                uint64_t T_3 = (T >> 11) & 0x7;
                                uint64_t R = (B_3 - 1) & 0x7;
                                
                                // Correction for base
                                int64_t c_b;
                                bool cond1_b = (A_3 < R);
                                bool cond2_b = (B_3 < R);
                                
                                if (!cond1_b && !cond2_b) c_b = 0;
                                else if (!cond1_b && cond2_b) c_b = 1;
                                else if (cond1_b && !cond2_b) c_b = -1;
                                else c_b = 0;
                                
                                // Correction for top
                                int64_t c_t;
                                bool cond1_t = (A_3 < R);
                                bool cond2_t = (T_3 < R);
                                
                                if (!cond1_t && !cond2_t) c_t = 0;
                                else if (!cond1_t && cond2_t) c_t = 1;
                                else if (cond1_t && !cond2_t) c_t = -1;
                                else c_t = 0;
                                
                                // Decode base and top
                                uint64_t a_top = (a >> (E + 14));
                                uint64_t base = ((a_top + c_b) << (E + 14)) | (B << E);
                                uint64_t top = ((a_top + c_t) << (E + 14)) | (T << E);
                                
                                uint64_t length = top - base;
                                Rd = length;
                                
                                DPRINTF(CheriDecode, "The length = %#llx\n", (unsigned long long)length);
                            } 

                        }});

                        0x04: cgettag({{
                            using namespace gem5::CHERIRiscvISA;

                            RegIndex cs1Idx    = CS1 + cap_reg::_CNullIdx;
                            RegIndex dstIdx    = RD + int_reg::_ZeroIdx;

                            DPRINTF(CheriDecode, "Getting tag for c%d and storing in x%d\n", cs1Idx, dstIdx);

                            bool tag = Cs1.getTag();
                            
                            Rd = tag;

                            DPRINTF(CheriDecode, "The tag value = %d\n", (int)tag);
                        }});

                        0x05: cgetsealed({{
                            using namespace gem5::CHERIRiscvISA;

                            RegIndex cs1Idx    = CS1 + cap_reg::_CNullIdx;
                            RegIndex dstIdx    = RD + int_reg::_ZeroIdx;

                            DPRINTF(CheriDecode, "Getting seal for c%d and storing in x%d\n", cs1Idx, dstIdx);

                            CAPTYPE meta = Cs1.getMetadata();
                            uint64_t otype = meta.otype; 

                            // A capability is sealed if otype is not the reserved "unsealed" value
                            // For 18-bit otype field, unsealed is 0x3FFFF (all 1s) 

                            const uint64_t OTYPE_UNSEALED = (1ULL << 18) - 1;

                            if (otype == OTYPE_UNSEALED) {
                                Rd = 0;
                                DPRINTF(CheriDecode, "Capability is unsealed. Otype = %#llx\n", (unsigned long long)otype);
                            } else {
                                Rd = 1;
                                DPRINTF(CheriDecode, "Capability is sealed. Otype = %#llx\n", (unsigned long long)otype);
                            }
                        }});

