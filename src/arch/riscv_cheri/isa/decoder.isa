                            DPRINTF(CheriDecode, "Testing exact equality of c%d and c%d and storing result in x%d\n",
                                cs1Idx, cs2Idx, dstIdx);

                            // Check if tags match
                            bool tags_equal = (Cs1.getTag() == Cs2.getTag());
                            
                            // Check if addresses match
                            bool addrs_equal = (Cs1.getAddress() == Cs2.getAddress());
                            
                            // Check if metadata matches
