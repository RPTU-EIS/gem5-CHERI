                    format COp {
                        0x1f: ccseal({{
                            using namespace gem5::CHERIRiscvISA;

                            RegIndex cs1Idx = CS1 + cap_reg::_CNullIdx;
                            RegIndex cs2Idx = CS2 + cap_reg::_CNullIdx;
                            RegIndex dstIdx = CD + cap_reg::_CNullIdx;

                            DPRINTF(CheriDecode, "Conditional sealing c%d from c%d with otype from c%d\n",
                                dstIdx, cs1Idx, cs2Idx);

                            // Copy source capability
                            Cd = Cs1;
                            
                            if (!Cs1.getTag()) {
                                Cd.setTag(false);
                                DPRINTF(CheriDecode, "Source capability cs1 invalid, clearing tag\n");
                            } else if (!Cs2.getTag()) {
                                Cd.setTag(false);
                                DPRINTF(CheriDecode, "Sealing capability cs2 invalid, clearing tag\n");
                            } else {
                                CAPTYPE meta1 = Cs1.getMetadata();
                                CAPTYPE meta2 = Cs2.getMetadata();
                                
                                // Check if cs2 has sealing permission (typically bit 10 of permissions)
                                const uint64_t PERM_SEAL = (1ULL << 10);
                                if ((meta2.perm & PERM_SEAL) == 0) {
                                    Cd.setTag(false);
                                    DPRINTF(CheriDecode, "cs2 lacks sealing permission, clearing tag\n");
                                } else {
                                    // Check if cs1 is already sealed
                                    const uint64_t OTYPE_UNSEALED = (1ULL << 18) - 1;  // 0x3FFFF
                                    if (meta1.otype != OTYPE_UNSEALED) {
                                        Cd.setTag(false);
                                        DPRINTF(CheriDecode, "Source capability already sealed, clearing tag\n");
                                    } else {
                                        // Get otype from cs2's address
                                        uint64_t new_otype = Cs2.getAddress() & ((1ULL << 18) - 1);
                                        
                                        // Check if new_otype is in valid range
                                        if (new_otype >= OTYPE_UNSEALED) {
                                            Cd.setTag(false);
                                            DPRINTF(CheriDecode, "Invalid otype value, clearing tag\n");
                                        } else {
                                            // Set the new otype
                                            CAPTYPE new_meta = meta1;
                                            new_meta.otype = new_otype;
                                            Cd.setMetadata(new_meta);
                                            
                                            DPRINTF(CheriDecode, "Conditionally sealed capability with otype = %#llx\n",
                                                    (unsigned long long)new_otype);
                                        }
                                    }
                                }
                            }
                        }});
                    } 

                    format COp {
                        0x20: ctestsubset({{
                            using namespace gem5::CHERIRiscvISA;

                            RegIndex cs1Idx = CS1 + cap_reg::_CNullIdx;
                            RegIndex cs2Idx = CS2 + cap_reg::_CNullIdx;
                            RegIndex dstIdx = RD + int_reg::_ZeroIdx;

                            DPRINTF(CheriDecode, "Testing if c%d is subset of c%d and storing result in x%d\n",
                                cs1Idx, cs2Idx, dstIdx);

                            // Both must be valid for meaningful comparison
                            if (!Cs1.getTag() || !Cs2.getTag()) {
                                Rd = 0;
                                DPRINTF(CheriDecode, "One or both capabilities invalid, returning 0\n");
                            } else {
                                CAPTYPE meta1 = Cs1.getMetadata();
                                CAPTYPE meta2 = Cs2.getMetadata();
                                
                                // Decode bounds for cs1
                                uint64_t a1 = Cs1.getAddress();
                                uint64_t B_hi1 = meta1.B;
                                uint64_t T_hi1 = meta1.T;
                                uint64_t B_E1 = meta1.BE;
                                uint64_t T_E1 = meta1.TE;
                                uint64_t I_E1 = meta1.IE;
                                
                                uint64_t E1, B1, T1, L_carry_out1, L_msb1;
                                
                                if (I_E1 == 0) {
                                    E1 = 0;
                                    T1 = (T_hi1 << 3) | T_E1;
                                    B1 = (B_hi1 << 3) | B_E1;
                                    L_carry_out1 = (T1 < (B1 & 0xFFF)) ? 1 : 0;
                                    L_msb1 = 0;
                                } else {
                                    E1 = (T_E1 << 3) | B_E1;
                                    T1 = T_hi1 << 3;
                                    B1 = B_hi1 << 3;
                                    L_carry_out1 = (T1 < (B1 & 0xFFF)) ? 1 : 0;
                                    L_msb1 = 1;
                                }
                                
                                uint64_t B_top2_1 = (B1 >> 12) & 0x3;
                                T1 |= ((B_top2_1 + L_carry_out1 + L_msb1) & 0x3) << 12;
                                
                                uint64_t A_3_1 = (a1 >> (E1 + 11)) & 0x7;
                                uint64_t B_3_1 = (B1 >> 11) & 0x7;
                                uint64_t T_3_1 = (T1 >> 11) & 0x7;
                                uint64_t R1 = (B_3_1 - 1) & 0x7;
                                
                                int64_t c_b1, c_t1;
                                bool cond1_b1 = (A_3_1 < R1);
                                bool cond2_b1 = (B_3_1 < R1);
                                if (!cond1_b1 && !cond2_b1) c_b1 = 0;
                                else if (!cond1_b1 && cond2_b1) c_b1 = 1;
                                else if (cond1_b1 && !cond2_b1) c_b1 = -1;
                                else c_b1 = 0;
                                
                                bool cond1_t1 = (A_3_1 < R1);
                                bool cond2_t1 = (T_3_1 < R1);
                                if (!cond1_t1 && !cond2_t1) c_t1 = 0;
                                else if (!cond1_t1 && cond2_t1) c_t1 = 1;
                                else if (cond1_t1 && !cond2_t1) c_t1 = -1;
                                else c_t1 = 0;
                                
                                uint64_t a_top1 = (a1 >> (E1 + 14));
                                uint64_t base1 = ((a_top1 + c_b1) << (E1 + 14)) | (B1 << E1);
                                uint64_t top1 = ((a_top1 + c_t1) << (E1 + 14)) | (T1 << E1);
                                
                                // Decode bounds for cs2
                                uint64_t a2 = Cs2.getAddress();
                                uint64_t B_hi2 = meta2.B;
                                uint64_t T_hi2 = meta2.T;
                                uint64_t B_E2 = meta2.BE;
                                uint64_t T_E2 = meta2.TE;
                                uint64_t I_E2 = meta2.IE;
                                
                                uint64_t E2, B2, T2, L_carry_out2, L_msb2;
                                
                                if (I_E2 == 0) {
                                    E2 = 0;
                                    T2 = (T_hi2 << 3) | T_E2;
                                    B2 = (B_hi2 << 3) | B_E2;
                                    L_carry_out2 = (T2 < (B2 & 0xFFF)) ? 1 : 0;
                                    L_msb2 = 0;
                                } else {
                                    E2 = (T_E2 << 3) | B_E2;
                                    T2 = T_hi2 << 3;
                                    B2 = B_hi2 << 3;
                                    L_carry_out2 = (T2 < (B2 & 0xFFF)) ? 1 : 0;
                                    L_msb2 = 1;
                                }
                                
                                uint64_t B_top2_2 = (B2 >> 12) & 0x3;
                                T2 |= ((B_top2_2 + L_carry_out2 + L_msb2) & 0x3) << 12;
                                
                                uint64_t A_3_2 = (a2 >> (E2 + 11)) & 0x7;
                                uint64_t B_3_2 = (B2 >> 11) & 0x7;
                                uint64_t T_3_2 = (T2 >> 11) & 0x7;
                                uint64_t R2 = (B_3_2 - 1) & 0x7;
                                
                                int64_t c_b2, c_t2;
                                bool cond1_b2 = (A_3_2 < R2);
                                bool cond2_b2 = (B_3_2 < R2);
                                if (!cond1_b2 && !cond2_b2) c_b2 = 0;
                                else if (!cond1_b2 && cond2_b2) c_b2 = 1;
                                else if (cond1_b2 && !cond2_b2) c_b2 = -1;
                                else c_b2 = 0;
                                
                                bool cond1_t2 = (A_3_2 < R2);
                                bool cond2_t2 = (T_3_2 < R2);
                                if (!cond1_t2 && !cond2_t2) c_t2 = 0;
                                else if (!cond1_t2 && cond2_t2) c_t2 = 1;
                                else if (cond1_t2 && !cond2_t2) c_t2 = -1;
                                else c_t2 = 0;
                                
                                uint64_t a_top2 = (a2 >> (E2 + 14));
                                uint64_t base2 = ((a_top2 + c_b2) << (E2 + 14)) | (B2 << E2);
                                uint64_t top2 = ((a_top2 + c_t2) << (E2 + 14)) | (T2 << E2);
                                
                                // Check if cs1 is subset of cs2
                                // Bounds: cs1's bounds must be within cs2's bounds
                                bool bounds_subset = (base1 >= base2) && (top1 <= top2);
                                
                                // Permissions: cs1's permissions must be subset of cs2's permissions
                                bool perms_subset = ((meta1.perm & ~meta2.perm) == 0);
                                
                                // Check otype compatibility
                                bool otype_compatible = (meta1.otype == meta2.otype);
                                
                                if (bounds_subset && perms_subset && otype_compatible) {
                                    Rd = 1;
                                    DPRINTF(CheriDecode, "c%d is subset of c%d\n", cs1Idx, cs2Idx);
                                } else {
                                    Rd = 0;
                                    DPRINTF(CheriDecode, "c%d is NOT subset of c%d (bounds=%d, perms=%d, otype=%d)\n",
                                            cs1Idx, cs2Idx,
                                            (int)bounds_subset, (int)perms_subset, (int)otype_compatible);
                                }
                            }
                        }});
                    } 

                    format COp {
