                            //     case 0:  misc_idx = MISCREG_PCC;       break;
                            //     case 1:  misc_idx = MISCREG_DDC;       break;
                            //     case 28: misc_idx = MISCREG_MTCC;      break;
                            //     case 29: misc_idx = MISCREG_MTDC;      break;
                            //     case 30: misc_idx = MISCREG_MSCRATCHC; break;
                            //     case 31: misc_idx = MISCREG_MEPCC;     break;
                            //     // default:
                            //     //     return std::make_shared<IllegalInstFault>(
                            //     //         "Unknown SCR", machInst);
                            // }

                            int mapped = scrToMiscReg(scr_index);
                            if (mapped < 0) {
                                return std::make_shared<IllegalInstFault>(
                                    "Unknown SCR index", machInst);
                            }
                            RegIndex misc_idx = static_cast<RegIndex>(mapped);

                            // Read SCR
                            CapRegContainer _oldVal = isa->readCapMiscReg(misc_idx);

                            // Only write SCR if cs1 != c0 (read-only when c0)
                            if (cs1_idx != 0 && scr_index != 0) {
                                // Read cs1 from the capability register file manually
                                CapRegContainer _cs1_val;
                                tc->getReg(capRegClass[cs1_idx], &_cs1_val);
                                isa->setCapMiscReg(misc_idx, _cs1_val);
                            }

                            // Write to Cd. Cd handles c0 fine because it's a write
                            // (writes to null cap reg are discarded by the framework).
                            Cd = _oldVal;
                        }}, IsNonSpeculative);
                    }
                     
                    format COp {
