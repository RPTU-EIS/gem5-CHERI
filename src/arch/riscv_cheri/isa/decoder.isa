                                    L_carry_out = (T < (B & 0xFFF)) ? 1 : 0;
                                    L_msb = 0;
                                } else {
                                    E = (T_E << 3) | B_E;   // {T_E, B_E}
                                    T = T_hi << 3;          // T[11:3] | 0
                                    B = B_hi << 3;          // B[13:3] | 0
                                    L_carry_out = (T < (B & 0xFFF)) ? 1 : 0;
                                    L_msb = 1;
                                }
                                
                                // Reconstruct T[13:12]
                                uint64_t B_top2 = (B >> 12) & 0x3;
                                T |= ((B_top2 + L_carry_out + L_msb) & 0x3) << 12;
                                
                                // Calculate correction c_b using truth table
                                uint64_t A_3 = (a >> (E + 11)) & 0x7;
                                uint64_t B_3 = (B >> 11) & 0x7;
                                uint64_t R = (B_3 - 1) & 0x7;
                                
                                int64_t c_b;
                                bool cond1 = (A_3 < R);
                                bool cond2 = (B_3 < R);
                                
                                if (!cond1 && !cond2) {
                                    c_b = 0;
                                } else if (!cond1 && cond2) {
                                    c_b = 1;
                                } else if (cond1 && !cond2) {
                                    c_b = -1;
                                } else { // cond1 && cond2
