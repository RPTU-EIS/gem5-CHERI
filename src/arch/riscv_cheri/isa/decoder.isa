                        0x0e: cclear({{
                            using namespace gem5::CHERIRiscvISA;

                            RegIndex dstIdx = CD + cap_reg::_CNullIdx;

                            DPRINTF(CheriDecode, "Clearing c%d\n", dstIdx);

                            // Clear capability - set to NULL (all zeros with tag cleared)
                            Cd.setTag(false);
                            Cd.setAddress(0);
                            Cd.setMetadata(0);
                            
                            DPRINTF(CheriDecode, "Cleared capability to NULL\n");
                        }});

                        0x10: fpclear({{
                            using namespace gem5::CHERIRiscvISA;

                            RegIndex rs1Idx = RS1 + int_reg::_ZeroIdx;

                            DPRINTF(CheriDecode, "Clearing floating point registers based on mask in x%d\n", rs1Idx);

                            // Get mask of which FP registers to clear
                            uint64_t mask = Rs1;
                            
                            // Clear floating point registers according to mask
                            // Each bit in mask corresponds to one FP register (bits 0-31)
                            for (int i = 0; i < 32; i++) {
                                if (mask & (1ULL << i)) {
                                    // Clear FP register i
                                    RegId fp_reg = floatRegClass[i];
                                    xc->setRegOperand(this, 0, (RegVal)0);  // Set to zero
                                    DPRINTF(CheriDecode, "Cleared f%d\n", i);
                                }
                            }
                            
                            DPRINTF(CheriDecode, "Cleared FP registers with mask %#llx\n", (unsigned long long)mask);
                        }});

                        0x11: csealentry({{
                            using namespace gem5::CHERIRiscvISA;

                            RegIndex cs1Idx = CS1 + cap_reg::_CNullIdx;
                            RegIndex dstIdx = CD + cap_reg::_CNullIdx;

                            DPRINTF(CheriDecode, "Sealing c%d as entry capability and storing in c%d\n", cs1Idx, dstIdx);

                            // Copy source capability
                            Cd = Cs1;
                            
                            if (!Cs1.getTag()) {
                                Cd.setTag(false);
                                DPRINTF(CheriDecode, "Source capability invalid, clearing tag\n");
                            } else {
                                CAPTYPE meta = Cs1.getMetadata();
                                
                                // Check if already sealed
                                const uint64_t OTYPE_UNSEALED = (1ULL << 18) - 1;  // 0x3FFFF
                                const uint64_t OTYPE_SENTRY = OTYPE_UNSEALED - 1;  // 0x3FFFE (reserved for sentries)
                                
                                if (meta.otype != OTYPE_UNSEALED) {
                                    Cd.setTag(false);
                                    DPRINTF(CheriDecode, "Capability already sealed, clearing tag\n");
                                } else {
                                    // Seal with sentry otype
                                    CAPTYPE new_meta = meta;
                                    new_meta.otype = OTYPE_SENTRY;
                                    Cd.setMetadata(new_meta);
                                    
                                    DPRINTF(CheriDecode, "Sealed as entry capability (otype=%#llx)\n", (unsigned long long)OTYPE_SENTRY);
                                }
                            }
                        }});

                        0x12: cloadtags({{

                            using namespace gem5::CHERIRiscvISA;

                            RegIndex cs1Idx = CS1 + cap_reg::_CNullIdx;
                            RegIndex dstIdx = RD + int_reg::_ZeroIdx;

                            DPRINTF(CheriDecode, "Loading tags from memory at c%d and storing in x%d\n", cs1Idx, dstIdx);

                            // Bring-up: capability enforcement (tag/seal/perm/
                            // bounds/alignment) is disabled throughout this port,
                            // and the early caps do not yet carry correct perms/
                            // otype, so gating cloadtags on those checks made it
                            // always return 0 (kernel panic "Bad cloadtags result
                            // 0x0"). Skip the checks and just read the tag table.
                            uint64_t vaddr = Cs1.getAddress();
                            const uint64_t caps_per_cache_line = 8;
                            const uint64_t cap_size = 16;  // 128-bit capability
                            const uint64_t access_length =
                                caps_per_cache_line * cap_size;

                            // cloadtags is a register-format instruction so it
                            // does not go through the load/store translation
                            // path; translate the virtual address ourselves. The
                            // tag table is keyed by physical address, the same
                            // way clc/csc read/write tags in cap_mem.isa.
                            auto *ctc = xc->tcBase();
                            // Use the virtual-address Request constructor (sets
                            // VALID_VADDR); the 4-arg form builds a PHYSICAL
                            // request and translateFunctional()'s getVaddr()
                            // would assert.
                            RequestPtr treq = std::make_shared<Request>(
                                vaddr, access_length, Request::Flags(),
                                Request::funcRequestorId, /*pc*/0,
                                ctc->contextId());
                            Fault tf = ctc->getMMUPtr()->translateFunctional(
                                treq, ctc, BaseMMU::Read);
                            uint64_t tag_bits = 0;
                            Addr pa = vaddr;
                            System *csys = ctc->getSystemPtr();
                            if (tf == NoFault) {
                                pa = treq->getPaddr();
                            } else {
                                // Bring-up: this early cloadtags targets a
                                // PHYSICAL address (e.g. 0x80204b00, in the DRAM
                                // range where the kernel is loaded) that is not
                                // mapped in the current page table, so translation
                                // faults. Fall back to treating the capability
                                // address as physical (identity) -- the tags for
                                // that region are already in the table.
                                pa = vaddr;
                                DPRINTF(CheriDecode, "cloadtags translate failed for vaddr %#llx, using identity pa\n", (unsigned long long)vaddr);
                            }
                            for (uint64_t i = 0; i < caps_per_cache_line; i++) {
                                if (csys->cheritagtable.getTag(pa + i * cap_size))
                                    tag_bits |= (1ULL << i);
                            }

                            DPRINTF(CheriDecode, "Loaded tag bits = %#llx from vaddr %#llx (pa-based)\n", (unsigned long long)tag_bits, (unsigned long long)vaddr);
                            Rd = tag_bits;

                        }});

                        0x14: jalr_pcc({{
                            using namespace gem5::CHERIRiscvISA;

                            DPRINTF(CheriDecode, "JALR.PCC: rd=x%d rs1=x%d\n", RD, RS1);

                            // Get current PCC from PC state
                            CapRegContainer pcc = xc->pcState().as<PCState>().pcc();
                            
                            // Calculate target address (clear bit 0 for alignment)
                            uint64_t target_addr = (Rs1 & ~1ULL);
                            
                            // Save return address (next PC) to integer register
                            Rd = NPC;
                            
                            // Decode PCC bounds
                            CAPTYPE meta = pcc.getMetadata();
                            uint64_t B_hi = meta.B;
                            uint64_t T_hi = meta.T;
                            uint64_t B_E = meta.BE;
                            uint64_t T_E = meta.TE;
                            uint64_t I_E = meta.IE;
                            
                            uint64_t E, B, T, L_carry_out, L_msb;
                            
                            if (I_E == 0) {
                                E = 0;
                                T = (T_hi << 3) | T_E;
                                B = (B_hi << 3) | B_E;
                                L_carry_out = (T < (B & 0xFFF)) ? 1 : 0;
                                L_msb = 0;
                            } else {
                                E = (T_E << 3) | B_E;
                                T = T_hi << 3;
                                B = B_hi << 3;
                                L_carry_out = (T < (B & 0xFFF)) ? 1 : 0;
                                L_msb = 1;
                            }
                            
                            uint64_t B_top2 = (B >> 12) & 0x3;
                            T |= ((B_top2 + L_carry_out + L_msb) & 0x3) << 12;
                            
                            uint64_t A_3 = (PC >> (E + 11)) & 0x7;
                            uint64_t B_3 = (B >> 11) & 0x7;
                            uint64_t T_3 = (T >> 11) & 0x7;
                            uint64_t R = (B_3 - 1) & 0x7;
                            
                            int64_t c_b, c_t;
                            bool cond1_b = (A_3 < R);
                            bool cond2_b = (B_3 < R);
                            if (!cond1_b && !cond2_b) c_b = 0;
                            else if (!cond1_b && cond2_b) c_b = 1;
                            else if (cond1_b && !cond2_b) c_b = -1;
                            else c_b = 0;
                            
                            bool cond1_t = (A_3 < R);
                            bool cond2_t = (T_3 < R);
                            if (!cond1_t && !cond2_t) c_t = 0;
                            else if (!cond1_t && cond2_t) c_t = 1;
                            else if (cond1_t && !cond2_t) c_t = -1;
                            else c_t = 0;
                            
                            uint64_t a_top = (PC >> (E + 14));
                            uint64_t base = ((a_top + c_b) << (E + 14)) | (B << E);
                            uint64_t top = ((a_top + c_t) << (E + 14)) | (T << E);
                            
                            // Check bounds: target must be within (base, top)
                            if (target_addr < base) {
                                // fault = std::make_shared<AddressFault>(target_addr, INST_ADDR_MISALIGNED);
                            } else if (target_addr + 4 > top) {  // min_instruction_bytes = 4
                                // fault = std::make_shared<AddressFault>(target_addr, INST_ADDR_MISALIGNED);
                            } else if ((target_addr & 0x1) != 0) {
                                // Check alignment (bit 0 must be 0)
                                // fault = std::make_shared<AddressFault>(target_addr, INST_ADDR_MISALIGNED);
                            } else {
                                // Update PC
                                NPC = target_addr;
                                
                                DPRINTF(CheriDecode, "JALR.PCC: jumping to 0x%x, return in x%d=0x%x\n",
                                        target_addr, RD, Rd);
                            }
                        }});

                    }
                    }

                   
