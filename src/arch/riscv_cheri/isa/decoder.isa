                    format COp {
                        0x09: csetboundsexact({{
                            using namespace gem5::CHERIRiscvISA;

                            RegIndex cs1Idx = CS1 + cap_reg::_CNullIdx;
                            RegIndex rs2Idx = RS2 + int_reg::_ZeroIdx;
                            RegIndex dstIdx = CD + cap_reg::_CNullIdx;

                            DPRINTF(CheriDecode, "Setting exact bounds for c%d from c%d with length from x%d\n",
                                dstIdx, cs1Idx, rs2Idx);

                            // Copy source capability
                            Cd = Cs1;
                            
                            if (!Cs1.getTag()) {
                                // Bring-up: stack caps are untagged (csp is a bare pointer), so
                                // &local = csetbounds(untagged stack ptr, N) would otherwise get
                                // no bounds. Apply the requested bounds so cgetlen()/cgetbase()
                                // report them (the kernel validates &local via cgetlen); keep the
                                // tag cleared.
                                {
                                    bool _uex = false;
                                    CAPTYPE _um = cc128EncodeBounds(Cs1.getMetadata(),
                                        Cs1.getAddress(), (uint64_t)(Rs2), &_uex);
                                    Cd.setMetadata(_um);
                                    Cd.setAddress(Cs1.getAddress());
                                    (void)_uex;
                                }
                                Cd.setTag(false);
                            } else {
                                uint64_t new_base = Cs1.getAddress();
                                uint64_t req_length = Rs2;
                                uint64_t new_top = new_base + req_length;
                                
                                // Get original bounds (same decoding as CSetBounds)
                                uint64_t a = Cs1.getAddress();
                                CAPTYPE meta = Cs1.getMetadata();
                                
                                uint64_t B_hi = meta.B;
                                uint64_t T_hi = meta.T;
                                uint64_t B_E = meta.BE;
                                uint64_t T_E = meta.TE;
                                uint64_t I_E = meta.IE;
                                
                                uint64_t E, B, T, L_carry_out, L_msb;
                                
                                if (I_E == 0) {
                                    E = 0;
                                    T = (T_hi << 3) | T_E;
                                    B = (B_hi << 3) | B_E;
                                    L_carry_out = (T < (B & 0xFFF)) ? 1 : 0;
                                    L_msb = 0;
                                } else {
                                    E = (T_E << 3) | B_E;
                                    T = T_hi << 3;
                                    B = B_hi << 3;
                                    L_carry_out = (T < (B & 0xFFF)) ? 1 : 0;
                                    L_msb = 1;
                                }
                                
                                uint64_t B_top2 = (B >> 12) & 0x3;
                                T |= ((B_top2 + L_carry_out + L_msb) & 0x3) << 12;
                                
                                uint64_t A_3 = (a >> (E + 11)) & 0x7;
                                uint64_t B_3 = (B >> 11) & 0x7;
                                uint64_t T_3 = (T >> 11) & 0x7;
                                uint64_t R = (B_3 - 1) & 0x7;
                                
                                int64_t c_b, c_t;
                                bool cond1_b = (A_3 < R);
                                bool cond2_b = (B_3 < R);
                                if (!cond1_b && !cond2_b) c_b = 0;
                                else if (!cond1_b && cond2_b) c_b = 1;
                                else if (cond1_b && !cond2_b) c_b = -1;
                                else c_b = 0;
                                
                                bool cond1_t = (A_3 < R);
                                bool cond2_t = (T_3 < R);
                                if (!cond1_t && !cond2_t) c_t = 0;
                                else if (!cond1_t && cond2_t) c_t = 1;
                                else if (cond1_t && !cond2_t) c_t = -1;
                                else c_t = 0;
                                
                                uint64_t a_top = (a >> (E + 14));
                                uint64_t orig_base = ((a_top + c_b) << (E + 14)) | (B << E);
                                uint64_t orig_top = ((a_top + c_t) << (E + 14)) | (T << E);
                                
                                // ── Compressed bounds encoding ──
                                // NOTE: strict "exact" enforcement (clearing the
                                // tag when the requested bounds are not exactly
                                // representable, or fall outside the source
                                // bounds) is DEFERRED along with the other CHERI
                                // checks. Previously this path cleared the tag
                                // for any region > 2^14 bytes, so the kernel's
                                // 2 MB devmap capability came back untagged and
                                // cgetbase/cgetlen returned 0 -> panic. We now
                                // compute compressed bounds exactly like
                                // csetbounds and keep the tag, so the bounds
                                // round-trip through cgetbase/cgetlen.
                                // (The orig_base/orig_top decode above is left
                                // in place, mirroring csetbounds, for when the
                                // representability checks are re-added.)
                                // CC128 bounds compression (regs/cc128_bounds.hh): smallest
                                // exponent that decodes back to exactly [base, base+len), else
                                // the tightest covering encoding. Consistent with cget* decode.
                                bool _exact = false;
                                CAPTYPE new_meta =
                                    cc128EncodeBounds(meta, new_base, req_length, &_exact);
                                uint64_t new_E = new_meta.IE ?
                                    ((uint64_t)((new_meta.TE << 3) | new_meta.BE)) : 0;
                                (void)_exact; (void)new_E;

                                Cd.setMetadata(new_meta);
                                Cd.setAddress(new_base);

                                DPRINTF(CheriDecode,
                                    "csetboundsexact: base=%#llx length=%llu E=%llu\n",
                                    (unsigned long long)new_base,
                                    (unsigned long long)req_length,
                                    (unsigned long long)new_E);
                            }
                        }});
                    } 

                    format COp {
                        0x0b: cseal({{
                            using namespace gem5::CHERIRiscvISA;

                            RegIndex cs1Idx = CS1 + cap_reg::_CNullIdx;
                            RegIndex cs2Idx = CS2 + cap_reg::_CNullIdx;
                            RegIndex dstIdx = CD + cap_reg::_CNullIdx;

                            DPRINTF(CheriDecode, "Sealing c%d from c%d with otype from c%d\n",
                                dstIdx, cs1Idx, cs2Idx);

                            // Copy source capability
                            Cd = Cs1;
                            
                            if (!Cs1.getTag()) {
                                Cd.setTag(false);
                                DPRINTF(CheriDecode, "Source capability cs1 invalid, clearing tag\n");
                            } else if (!Cs2.getTag()) {
                                Cd.setTag(false);
                                DPRINTF(CheriDecode, "Sealing capability cs2 invalid, clearing tag\n");
                            } else {
                                CAPTYPE meta1 = Cs1.getMetadata();
                                CAPTYPE meta2 = Cs2.getMetadata();
                                
                                // Check if cs1 is already sealed (otype != unsealed value)
                                const uint64_t OTYPE_UNSEALED = (1ULL << 18) - 1;  // 0x3FFFF
                                if (meta1.otype != OTYPE_UNSEALED) {
                                    Cd.setTag(false);
                                    DPRINTF(CheriDecode, "Source capability already sealed, clearing tag\n");
                                } else {
                                    // Get otype from cs2's address (lower bits used as otype)
                                    uint64_t new_otype = Cs2.getAddress() & ((1ULL << 18) - 1);
                                    
                                    // Check if new_otype is in valid range (not the unsealed value)
                                    if (new_otype >= OTYPE_UNSEALED) {
                                        Cd.setTag(false);
                                        DPRINTF(CheriDecode, "Invalid otype value, clearing tag\n");
                                    } else {
                                        // Set the new otype
                                        CAPTYPE new_meta = meta1;
                                        new_meta.otype = new_otype;
                                        Cd.setMetadata(new_meta);
                                        
                                        DPRINTF(CheriDecode, "Sealed capability with otype = %#llx\n",
                                                (unsigned long long)new_otype);
                                    }
                                }
                            }
                            
                        }});
                    } 

                    format COp {
                        0x0c: cunseal({{
                            using namespace gem5::CHERIRiscvISA;

                            RegIndex cs1Idx = CS1 + cap_reg::_CNullIdx;
                            RegIndex cs2Idx = CS2 + cap_reg::_CNullIdx;
                            RegIndex dstIdx = CD + cap_reg::_CNullIdx;

                            DPRINTF(CheriDecode, "Unsealing c%d from c%d with otype from c%d\n",
                                dstIdx, cs1Idx, cs2Idx);

                            // Copy source capability
                            Cd = Cs1;
                            
                            if (!Cs1.getTag()) {
                                Cd.setTag(false);
                                DPRINTF(CheriDecode, "Source capability cs1 invalid, clearing tag\n");
                            } else if (!Cs2.getTag()) {
                                Cd.setTag(false);
                                DPRINTF(CheriDecode, "Unsealing capability cs2 invalid, clearing tag\n");
                            } else {
                                CAPTYPE meta1 = Cs1.getMetadata();
                                CAPTYPE meta2 = Cs2.getMetadata();
                                
                                const uint64_t OTYPE_UNSEALED = (1ULL << 18) - 1;  // 0x3FFFF
                                
                                // Check if cs1 is sealed
                                if (meta1.otype == OTYPE_UNSEALED) {
                                    Cd.setTag(false);
                                    DPRINTF(CheriDecode, "Source capability not sealed, clearing tag\n");
                                } else {
                                    // Get otype from cs2's address
                                    uint64_t unseal_otype = Cs2.getAddress() & ((1ULL << 18) - 1);
                                    
                                    // Check if otypes match
                                    if (meta1.otype != unseal_otype) {
                                        Cd.setTag(false);
                                        DPRINTF(CheriDecode, "Otype mismatch (sealed=%#llx, unsealing=%#llx), clearing tag\n",
                                                (unsigned long long)meta1.otype,
                                                (unsigned long long)unseal_otype);
                                    } else {
                                        // Unseal by setting otype to unsealed value
                                        CAPTYPE new_meta = meta1;
                                        new_meta.otype = OTYPE_UNSEALED;
                                        Cd.setMetadata(new_meta);
                                        
                                        DPRINTF(CheriDecode, "Unsealed capability (otype was %#llx)\n",
                                                (unsigned long long)unseal_otype);
                                    }
                                }
                            }
                        }});
                    } 

                    format COp {
                        0x0d: candperm({{
                            using namespace gem5::CHERIRiscvISA;

                            RegIndex cs1Idx = CS1 + cap_reg::_CNullIdx;
                            RegIndex rs2Idx = RS2 + int_reg::_ZeroIdx;
                            RegIndex dstIdx = CD + cap_reg::_CNullIdx;

                            DPRINTF(CheriDecode, "Masking permissions for c%d from c%d with mask from x%d\n",
                                dstIdx, cs1Idx, rs2Idx);

                            // Copy source capability
                            Cd = Cs1;
                            
                            if (!Cs1.getTag()) {
                                Cd.setTag(false);
                                DPRINTF(CheriDecode, "Source capability invalid, clearing tag\n");
                            } else {
                                CAPTYPE meta = Cs1.getMetadata();

                                // The architectural permission mask has arch perms at
                                // 0-11 and user perms SW0..SW3 at bits 15..18. Compact
                                // it into our stored layout (SW1/SW2/SW3 at stored bits
                                // 12/13/14; SW0 stays at 15) before ANDing -- the old
                                // `Rs2 & 0xFFFF` silently dropped SW1(=SW_VMEM)/SW2/SW3
                                // at bits 16-18. Mirror of cgetperm's expansion.
                                uint64_t arch_mask = (uint64_t)Rs2;
                                uint64_t perm_mask = (arch_mask & 0x8FFFULL) |
                                                     ((arch_mask >> 4) & 0x7000ULL);

                                // AND current permissions with mask
                                uint64_t new_perms = meta.perm & perm_mask;
                                
                                // Update metadata
                                CAPTYPE new_meta = meta;
                                new_meta.perm = new_perms;
                                Cd.setMetadata(new_meta);
                                
                                    DPRINTF(CheriDecode, "Old permissions = %#llx, mask = %#llx, new permissions = %#llx\n",
                                        (unsigned long long)meta.perm,
                                        (unsigned long long)perm_mask,
                                        (unsigned long long)new_perms);
                            }
                        }});
                    } 

                    format COp {
                        0x0e: csetflags({{
                            using namespace gem5::CHERIRiscvISA;

                            RegIndex cs1Idx = CS1 + cap_reg::_CNullIdx;
                            RegIndex rs2Idx = RS2 + int_reg::_ZeroIdx;
                            RegIndex dstIdx = CD + cap_reg::_CNullIdx;


                            DPRINTF(CheriDecode, "CSetFlags: Setting flags of c%d with capability from c%d and flags from x%d\n", dstIdx, cs1Idx, rs2Idx);
                            // DPRINTF(CheriDecode, "Setting flags for c%d with capability from c%d\n", dstIdx, cs1Idx)
                            //        << " and flag from x" << rs2Idx << " with value = " << (Rs2 & 0x1) << std::endl;

                            // Copy source capability
                            Cd = Cs1;
                            
                            if (!Cs1.getTag()) {
                                Cd.setTag(false);
                                DPRINTF(CheriDecode, "Source capability invalid, clearing tag\n");
                            } else {
                                // Get metadata, modify flag, write back
                                CAPTYPE meta = Cs1.getMetadata();
                                meta.flag = Rs2 & 0x1;  // 1-bit flag
                                Cd.setMetadata(meta);
                                
                                    DPRINTF(CheriDecode, "Set flag for c%d with value = %llu\n",
                                        dstIdx, (unsigned long long)meta.flag);
                            }

                        }});
                    } 

                    format COp {
