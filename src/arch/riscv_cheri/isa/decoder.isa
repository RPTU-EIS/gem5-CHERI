            format CapDataLoad{ 
                0x0: lb_cap({{
                        Rd_sd = Mem_sb;
                    }},
                    ea_code = {{
                        // Cs1 = CapRegContainer::almighty(0x80010000);
                        EA = rvZext(Cs1.getAddress() + offset);
                    }},
                    cap_check_code = {{
                        CheriCapException _cf = Cs1.checkForLoad(Cs1.getMetadata(), Cs1.getAddress(), Cs1.getTag(), Cs1.isSealed(), EA, 1, false);
                        // if (_cf != CheriCapException::None)
                        //     return std::make_shared<CheriCapFault>(_cf);
                    }});
                0x1: lh_cap({{
                        Rd_sd = Mem_sh;
                    }},
                    ea_code = {{
                        EA = rvZext(Cs1.getAddress() + offset);
                    }},
                    cap_check_code = {{
                        CheriCapException _cf = Cs1.checkForLoad(Cs1.getMetadata(), Cs1.getAddress(), Cs1.getTag(), Cs1.isSealed(), EA, 2, false);
                        // if (_cf != CheriCapException::None)
                        //     return std::make_shared<CheriCapFault>(_cf);
                    }});
                0x2: lw_cap({{
                        Rd_sd = Mem_sw;
                    }},
                    ea_code = {{
                        EA = rvZext(Cs1.getAddress() + offset);
                    }},
                    cap_check_code = {{
                        CheriCapException _cf = Cs1.checkForLoad(Cs1.getMetadata(), Cs1.getAddress(), Cs1.getTag(), Cs1.isSealed(), EA, 4, false);
                        // if (_cf != CheriCapException::None)
                        //     return std::make_shared<CheriCapFault>(_cf);
                    }});
                
                0x3: ld_cap({{
                        Rd_sd = Mem_sd;
                    }},
                    ea_code = {{
                        EA = rvZext(Cs1.getAddress() + offset);
                    }},
                    cap_check_code = {{
                        CheriCapException _cf = Cs1.checkForLoad(Cs1.getMetadata(), Cs1.getAddress(), Cs1.getTag(), Cs1.isSealed(), EA, 8, false);
                        // if (_cf != CheriCapException::None)
                        //     return std::make_shared<CheriCapFault>(_cf);
                        }});

                // Unsigned data loads via a capability base (zero-extended).
                0x4: lbu_cap({{
                        Rd = Mem_ub;
                    }},
                    ea_code = {{
                        EA = rvZext(Cs1.getAddress() + offset);
                    }},
                    cap_check_code = {{
                        CheriCapException _cf = Cs1.checkForLoad(Cs1.getMetadata(), Cs1.getAddress(), Cs1.getTag(), Cs1.isSealed(), EA, 1, false);
                    }});
                0x5: lhu_cap({{
                        Rd = Mem_uh;
                    }},
                    ea_code = {{
                        EA = rvZext(Cs1.getAddress() + offset);
                    }},
                    cap_check_code = {{
                        CheriCapException _cf = Cs1.checkForLoad(Cs1.getMetadata(), Cs1.getAddress(), Cs1.getTag(), Cs1.isSealed(), EA, 2, false);
                    }});
                0x6: lwu_cap({{
                        Rd = Mem_uw;
                    }},
                    ea_code = {{
                        EA = rvZext(Cs1.getAddress() + offset);
                    }},
                    cap_check_code = {{
                        CheriCapException _cf = Cs1.checkForLoad(Cs1.getMetadata(), Cs1.getAddress(), Cs1.getTag(), Cs1.isSealed(), EA, 4, false);
                    }});

            }
        }

        0x01: decode FUNCT3 {
