                            DPRINTF(CheriDecode, "Clearing tag of c%d and storing in c%d\n", cs1Idx, dstIdx);

                            // Copy capability but clear the tag
                            Cd = Cs1;
                            Cd.setTag(false);
                            
                                DPRINTF(CheriDecode, "Cleared tag (addr=%#llx preserved)\n", (unsigned long long)Cs1.getAddress());
                        }});

                        0x0c: jalr_cap({{
                            using namespace gem5::CHERIRiscvISA;

                            DPRINTF(CheriDecode, "JALR.CAP: cd=c%d cs1=c%d\n", 
                                    CD + cap_reg::_CNullIdx, CS1 + cap_reg::_CNullIdx);

                            // Check cs1 validity
                            if (!Cs1.getTag()) {
                                // TODO: raise CHERI tag violation fault
                                // fault = std::make_shared<CheriCapException>(CapEx_TagViolation, CS1);
                            } else {
                                // ── Get current PCState (const ref, then build new one) ──
                                const PCStateBase &pcBaseConst = xc->pcState();
                                const PCState &pc_state_in = pcBaseConst.as<PCState>();

                                // Capture instruction PC BEFORE modification
                                Addr inst_pc = pc_state_in.instAddr();

                                // jalr_cap is 4 bytes
                                Addr ret_addr = inst_pc + 4;

                                // Target address with low bit cleared
                                Addr target_addr = Cs1.getAddress() & ~1ULL;

                                DPRINTF(CheriDecode,
                                    "JALR.CAP ENTRY: inst_pc=0x%lx, ret_addr=0x%lx, target=0x%lx\n",
                                    inst_pc, ret_addr, target_addr);

                                // ── Build return capability (sentry-sealed current PCC at ret_addr) ──
                                CapRegContainer current_pcc = pc_state_in.pcc();
                                CapRegContainer ret_cap = current_pcc;
                                CAPTYPE ret_meta = current_pcc.getMetadata();
                                ret_meta.otype = (1ULL << 18) - 2;  // sentry
                                ret_cap.setMetadata(ret_meta);
                                ret_cap.setAddress(ret_addr);
                                Cd = ret_cap;

                                // ── Build new PCC from Cs1 ──
                                CapRegContainer new_pcc = Cs1;
                                new_pcc.setAddress(target_addr);
                                CAPTYPE new_meta = new_pcc.getMetadata();
                                if (new_meta.otype == ((1ULL << 18) - 2)) {
                                    new_meta.otype = (1ULL << 18) - 1;  // unseal sentry
                                    new_pcc.setMetadata(new_meta);
                                }

                                // ── Update PCState (use the c_jalr pattern: only set npc) ──
                                PCState new_pc_state = pc_state_in;
                                new_pc_state.pcc(new_pcc);
                                new_pc_state.npc(target_addr);    // tell framework where to fetch next
                                xc->pcState(new_pc_state);

                                DPRINTF(CheriDecode,
                                    "JALR.CAP POST: npc=0x%lx, pcc.addr=0x%lx\n",
                                    new_pc_state.npc(), new_pc_state.pcc().getAddress());
                            }
                        }});

                        // 0x0c: jalr_cap({{
                        //     using namespace gem5::CHERIRiscvISA;

