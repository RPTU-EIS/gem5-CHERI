                                //     uint64_t new_T = (new_top >> new_E) & ((1ULL << 14) - 1);
                                    
                                //     // Update metadata
                                //     CAPTYPE new_meta = meta;
                                    
                                //     if (new_E == 0) {
                                //         // Exact representation possible
                                //         new_meta.IE = 0;
                                //         new_meta.BE = new_B & 0x7;
                                //         new_meta.TE = new_T & 0x7;
                                //         new_meta.B = (new_B >> 3) & 0x7FF;
                                //         new_meta.T = (new_T >> 3) & 0x1FF;
                                //     } else {
                                //         // Compressed representation
                                //         new_meta.IE = 1;
                                //         new_meta.BE = new_E & 0x7;
                                //         new_meta.TE = (new_E >> 3) & 0x7;
                                //         new_meta.B = (new_B >> 3) & 0x7FF;
                                //         new_meta.T = (new_T >> 3) & 0x1FF;
                                //     }
                                    
                                //     Cd.setMetadata(new_meta);
                                //     Cd.setAddress(new_base);
                                    
                                //     DPRINTF(CheriDecode, "Set bounds: base = %#llx, length = %llu, E = %llu\n",
                                //         (unsigned long long)new_base,
                                //         (unsigned long long)req_length,
                                //         (unsigned long long)new_E);
                                // }

                                // CC128 bounds compression (regs/cc128_bounds.hh): smallest
                                // exponent that decodes back to exactly [base, base+len), else
                                // the tightest covering encoding. Consistent with cget* decode.
                                bool _exact = false;
                                CAPTYPE new_meta =
                                    cc128EncodeBounds(meta, new_base, req_length, &_exact);
                                uint64_t new_E = new_meta.IE ?
                                    ((uint64_t)((new_meta.TE << 3) | new_meta.BE)) : 0;
                                (void)_exact; (void)new_E;
                                
                                Cd.setMetadata(new_meta);
                                Cd.setAddress(new_base);
                                
                                DPRINTF(CheriDecode, "Set bounds (bounds check skipped): base = %#llx, length = %llu, E = %llu\n",
                                    (unsigned long long)new_base,
                                    (unsigned long long)req_length,
                                    (unsigned long long)new_E);

                                xc->tcBase()->setReg(intRegClass[CD], new_base);
                            }
                        }});
