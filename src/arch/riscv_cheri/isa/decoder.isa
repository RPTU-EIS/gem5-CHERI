                    format COp {
                        0x1d: cbuildcap({{
                            using namespace gem5::CHERIRiscvISA;

                            RegIndex cs1Idx = CS1 + cap_reg::_CNullIdx;
                            RegIndex cs2Idx = CS2 + cap_reg::_CNullIdx;
                            RegIndex dstIdx = CD + cap_reg::_CNullIdx;

                            DPRINTF(CheriDecode, "Building capability c%d from c%d (permissions/otype) and c%d (bounds/address)\n",
                                dstIdx, cs1Idx, cs2Idx);

                            // Start with cs2 (bounds and address)
                            Cd = Cs2;
                            
                            if (!Cs1.getTag() || !Cs2.getTag()) {
                                Cd.setTag(false);
                                DPRINTF(CheriDecode, "Source capability invalid, clearing tag\n");
                            } else {
                                CAPTYPE meta1 = Cs1.getMetadata();
                                CAPTYPE meta2 = Cs2.getMetadata();
                                
                                // Build new metadata: permissions and otype from cs1, bounds from cs2
                                CAPTYPE new_meta = meta2;  // Keep bounds (B, T, BE, TE, IE)
                                new_meta.perm = meta1.perm;  // Copy permissions from cs1
                                new_meta.otype = meta1.otype;  // Copy otype from cs1
                                new_meta.flag = meta1.flag;  // Copy flag from cs1
                                
                                Cd.setMetadata(new_meta);
                                Cd.setAddress(Cs2.getAddress());  // Use address from cs2
                                
                                    DPRINTF(CheriDecode, "Built capability with perms=%#llx, otype=%#llx\n",
                                        (unsigned long long)meta1.perm,
                                        (unsigned long long)meta1.otype);

                                xc->tcBase()->setReg(intRegClass[CD], Cs2.getAddress());
                            }
                        }});
                    } 

                    format COp {
                        0x1e: ccopytype({{
                            using namespace gem5::CHERIRiscvISA;

                            RegIndex cs1Idx = CS1 + cap_reg::_CNullIdx;
                            RegIndex cs2Idx = CS2 + cap_reg::_CNullIdx;
                            RegIndex dstIdx = CD + cap_reg::_CNullIdx;

                            DPRINTF(CheriDecode, "Copying otype from c%d to c%d and storing in c%d\n",
                                cs2Idx, cs1Idx, dstIdx);

                            // Copy source capability cs1
                            Cd = Cs1;
                            
                            if (!Cs1.getTag() || !Cs2.getTag()) {
                                Cd.setTag(false);
                                DPRINTF(CheriDecode, "Source capability invalid, clearing tag\n");
                            } else {
                                CAPTYPE meta1 = Cs1.getMetadata();
                                CAPTYPE meta2 = Cs2.getMetadata();
                                
                                // Copy otype from cs2 to cs1's capability
                                CAPTYPE new_meta = meta1;
                                new_meta.otype = meta2.otype;
                                Cd.setMetadata(new_meta);
                                
                                    DPRINTF(CheriDecode, "Copied otype %#llx from c%d to c%d\n",
                                        (unsigned long long)meta2.otype, cs2Idx, dstIdx);
                            }
                        }});
