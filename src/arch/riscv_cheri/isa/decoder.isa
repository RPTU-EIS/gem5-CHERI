////////////////////////////////////////////////////////////////////
//
// The RISC-V ISA decoder
//

// In theory, all registers should be sign extended if not operating in the
// full MXLEN register, but that will cause memory address out of range as it
// is always regarded as uint64. So we'll zero extend PC related registers and
// memory address, and sign extend others.



decode QUADRANT default Unknown::unknown() {
    0x0: decode COPCODE {
        0x0: CIncSpOp::c_addi4spn({{
            imm = CIMM8<1:1> << 2 |
                  CIMM8<0:0> << 3 |
                  CIMM8<7:6> << 4 |
                  CIMM8<5:2> << 6;
        }}, {{
            if (imm == 0)
                return std::make_shared<IllegalInstFault>("immediate = 0",
                                                           machInst);
            // PURECAP: c.addi4spn is c.cincoffset4cspn -- cd' = csp + imm, keep
            // csp's tag and bounds. Write NO register via the framework; the dest
            // is cd' (RP2+8). Read csp's cap for tag+bounds, take its address via
            // the int `sp` source view, then write the integer dest and the cap
            // dest (LAST, restoring tag+bounds) -- robust to shared-container or
            // one-way int->cap sync.
            using namespace gem5::CHERIRiscvISA;
            auto *_tc = xc->tcBase();
            CapRegContainer _csp;
            _tc->getReg(cap_reg::CSp, &_csp);
            uint64_t _na = rvSext(sp + imm);
            _tc->setReg(intRegClass[RP2 + 8], _na);
            _csp.setAddress(_na);
            _tc->setReg(capRegClass[RP2 + 8], &_csp);
        }}, uint64_t);
        format CompressedLoad {
            // PURECAP: this encoding (C0, funct3=001) is c.lq (load 128-bit
            // capability), NOT c.fld. Base is capability reg Cp1 (rs1',
            // bits[9:7]), destination is cap reg Cp2 (rd', bits[4:2]).
            0x1: CapLoad::c_lq({{
                Cp2 = _loadedCap;
            }},
                ea_code = {{
                    EA = rvZext(Cp1.getAddress() + offset);
                }},
                cap_check_code = {{ }},
                offset_code = {{
                    // c.lq uimm: [5:4]=inst[12:11], [8]=inst[10], [7:6]=inst[6:5]
                    offset = (CIMM3<2:1> << 4) | (CIMM3<0:0> << 8) |
                             (CIMM2 << 6);
                }});
            0x2: c_lw({{
                offset = CIMM2<1:1> << 2 |
                         CIMM3 << 3 |
                         CIMM2<0:0> << 6;
            }}, {{
                Rp2_sd = Mem_sw;
            }}, {{
                EA = rvZext(Rp1 + offset);
            }});
            0x3: decode RVTYPE {
                0x0: c_flw({{
                    offset = CIMM2<1:1> << 2 |
                             CIMM3 << 3 |
                             CIMM2<0:0> << 6;
                }}, {{
                    STATUS status = xc->readMiscReg(MISCREG_STATUS);
                    if (status.fs == FPUStatus::OFF)
                        return std::make_shared<IllegalInstFault>("FPU is off",
                                                                   machInst);

                    status.fs = FPUStatus::DIRTY;
                    xc->setMiscReg(MISCREG_STATUS, status);

                    freg_t fd = freg(f32(Mem_uw));
                    Fp2_bits = fd.v;
                }}, {{
                    EA = (uint32_t)(Rp1_uw + offset);
                }});
                0x1: c_ld({{
                    offset = CIMM3 << 3 | CIMM2 << 6;
                }}, {{
                    Rp2_sd = Mem_sd;
                }}, {{
                    EA = Rp1 + offset;
                }});
            }
        }
        0x4: decode CFUNCT6LOW3 {
            format CompressedLoad {
                0x0: c_lbu({{
                    offset = (CIMM2<0:0> << 1) | CIMM2<1:1>;
                }}, {{
                    Rp2 = Mem_ub;
                }}, {{
                    EA = rvZext(Rp1 + offset);
                }});
                0x1: decode CFUNCT1BIT6 {
                    0x0: c_lhu({{
                        offset = CIMM2<0:0> << 1;
                    }}, {{
                        Rp2 = Mem_uh;
                    }}, {{
                        EA = rvZext(Rp1 + offset);
                    }});
                    0x1: c_lh({{
                        offset = CIMM2<0:0> << 1;
                    }}, {{
                        Rp2_sd = Mem_sh;
                    }}, {{
                        EA = rvZext(Rp1 + offset);
                    }});
                }
            }
            format CompressedStore {
                0x2: c_sb({{
                    offset = (CIMM2<0:0> << 1) | CIMM2<1:1>;
                }}, {{
                    Mem_ub = Rp2_ub;
                }}, ea_code={{
                    EA = rvZext(Rp1 + offset);
                }});
                0x3: c_sh({{
                    offset = (CIMM2<0:0> << 1);
                }}, {{
                    Mem_uh = Rp2_uh;
                }}, ea_code={{
                    EA = rvZext(Rp1 + offset);
                }});
            }
        }
        format CompressedStore {
            // PURECAP: this encoding (C0, funct3=101) is c.sq (store 128-bit
            // capability), NOT c.fsd. Base cap reg Cp1 (rs1', bits[9:7]),
            // source cap reg Cp2 (rs2', bits[4:2]).
            0x5: CapStore::c_sq({{
                _storeCap = Cp2;
            }},
                ea_code = {{
                    EA = rvZext(Cp1.getAddress() + offset);
                }},
                cap_check_code = {{ }},
                offset_code = {{
                    // c.sq uimm: [5:4]=inst[12:11], [8]=inst[10], [7:6]=inst[6:5]
                    offset = (CIMM3<2:1> << 4) | (CIMM3<0:0> << 8) |
                             (CIMM2 << 6);
                }});
            0x6: c_sw({{
                offset = CIMM2<1:1> << 2 |
                         CIMM3 << 3 |
                         CIMM2<0:0> << 6;
            }}, {{
                Mem_uw = Rp2_uw;
            }}, ea_code={{
                EA = rvZext(Rp1 + offset);
            }});
            0x7: decode RVTYPE {
                0x0: c_fsw({{
                    offset = CIMM2<1:1> << 2 |
                             CIMM3 << 3 |
                             CIMM2<0:0> << 6;
                }}, {{
                    STATUS status = xc->readMiscReg(MISCREG_STATUS);
                    if (status.fs == FPUStatus::OFF)
                        return std::make_shared<IllegalInstFault>("FPU is off",
                                                                   machInst);

                    Mem_uw = unboxF32(boxF32(Fp2_bits));
                }}, {{
                    EA = (uint32_t)(Rp1_uw + offset);
                }});
                0x1: c_sd({{
                    offset = CIMM3 << 3 | CIMM2 << 6;
                }}, {{
                    Mem_ud = Rp2_ud;
                }}, {{
                    EA = Rp1 + offset;
                }});
            }
        }
    }
    0x1: decode COPCODE {
        0x0: CIOp::c_addi({{
            imm = sext<6>(CIMM5 | (CIMM1 << 5));
        }}, {{
            if ((RC1 == 0) != (imm == 0)) {
                if (RC1 == 0) {
                    // imm != 0 is HINT
                } else {
                    // imm == 0 is HINT
                }
            }
            Rc1_sd = rvSext(Rc1_sd + imm);
        }});
        0x1: decode RVTYPE {
            0x0: CJOp::c_jal({{
                ra_sw = NPC_uw;
                NPC_uw = PC_uw + imm;
            }}, IsDirectControl, IsUncondControl, IsCall);
            0x1: CIOp::c_addiw({{
                imm = sext<6>(CIMM5 | (CIMM1 << 5));
            }}, {{
                if (RC1 == 0) {
                    return std::make_shared<IllegalInstFault>(
                            "source reg x0", machInst);
                }
                Rc1_sw = (int32_t)(Rc1_sw + imm);
            }});
        }
        0x2: CIOp::c_li({{
            imm = sext<6>(CIMM5 | (CIMM1 << 5));
        }}, {{
            // RC1 == 0 is HINT
            Rc1_sd = imm;
        }});
        0x3: decode RC1 {
            0x2: CIncSpOp::c_addi16sp({{
                imm = sext<10>((CIMM5<4:4> << 4) |
                               (CIMM5<0:0> << 5) |
                               (CIMM5<3:3> << 6) |
                               (CIMM5<2:1> << 7) |
                               (CIMM1 << 9));
            }}, {{
                if (imm == 0) {
                    return std::make_shared<IllegalInstFault>(
                            "immediate = 0", machInst);
                }
                // PURECAP: c.addi16sp is c.cincoffset16csp -- adjust csp while
                // preserving its tag and bounds. int and cap share ONE register
                // container, so an integer dest-operand writeback zeroes csp's
                // tag+metadata (that stripped csp untagged in every prologue and
                // broke stack-derived &local -> kmem_subinit "valid capability
                // min"). This format writes NO register via the framework.
                // Order that works whether int/cap share one container or sync
                // one-way: (1) read csp's cap FIRST to save tag+bounds, (2)
                // write the integer sp (c.sqsp/c.lqsp address off int sp), (3)
                // write the cap LAST so tag+bounds are restored onto the result.
                using namespace gem5::CHERIRiscvISA;
                auto *_tc = xc->tcBase();
                CapRegContainer _csp;
                _tc->getReg(cap_reg::CSp, &_csp);
                uint64_t _na = rvSext(sp + imm);
                _tc->setReg(int_reg::Sp, _na);
                _csp.setAddress(_na);
                _tc->setReg(cap_reg::CSp, &_csp);
            }});
            default: CIOp::c_lui({{
                imm = sext<6>(CIMM5 | (CIMM1 << 5)) << 12;
            }}, {{
                // RC1 == 0 is HINT
                if (imm == 0) {
                    return std::make_shared<IllegalInstFault>(
                            "immediate = 0", machInst);
                }
                Rc1_sd = imm;
            }});
        }
        0x4: decode CFUNCT2HIGH {
            format CIOp {
                0x0: c_srli({{
                    imm = CIMM5 | (CIMM1 << 5);
                }}, {{
                    if (rvSelect((bool)CIMM1, false)) {
                        return std::make_shared<IllegalInstFault>(
                                "shmat[5] != 0", machInst);
                    }
                    if (imm == 0) {
                        // C.SRLI64, HINT for RV32/RV64
                    }
                    // The MSB can never be 1, hence no need to sign ext.
                    Rp1 = rvZext(Rp1) >> imm;
                }}, uint64_t);
                0x1: c_srai({{
                    imm = CIMM5 | (CIMM1 << 5);
                }}, {{
                    if (rvSelect((bool)CIMM1, false)) {
                        return std::make_shared<IllegalInstFault>(
                                "shmat[5] != 0", machInst);
                    }
                    if (imm == 0) {
                        // C.SRAI64, HINT for RV32/RV64
                    }
                    Rp1_sd = rvSext(Rp1_sd) >> imm;
                }}, uint64_t);
                0x2: c_andi({{
                    imm = CIMM5;
                    if (CIMM1 > 0)
                        imm |= ~((uint64_t)0x1F);
                }}, {{
                    Rp1 = rvSext(Rp1 & imm);
                }}, uint64_t);
            }
            format CompressedROp {
                0x3: decode CFUNCT1 {
                    0x0: decode CFUNCT2LOW {
                        0x0: c_sub({{
                            Rp1 = rvSext(Rp1 - Rp2);
                        }});
                        0x1: c_xor({{
                            Rp1 = rvSext(Rp1 ^ Rp2);
                        }});
                        0x2: c_or({{
                            Rp1 = rvSext(Rp1 | Rp2);
                        }});
                        0x3: c_and({{
                            Rp1 = rvSext(Rp1 & Rp2);
                        }});
                    }
                    0x1: decode CFUNCT2LOW {
                        0x0: decode RVTYPE {
                            0x1: c_subw({{
                                Rp1_sd = (int32_t)Rp1_sd - Rp2_sw;
                            }});
                        }
                        0x1: decode RVTYPE {
                            0x1: c_addw({{
                                Rp1_sd = (int32_t)Rp1_sd + Rp2_sw;
                            }});
                        }
                        0x2: c_mul({{
                            Rp1_sd = rvSext(Rp1_sd * Rp2_sd);
                        }}, IntMultOp);
                        0x3: decode RP2 {
                            0x0: c_zext_b({{
                                Rp1 = Rp1 & 0xFFULL;
                            }});
                            0x1: c_sext_b({{
                                Rp1 = sext<8>(Rp1 & 0xFFULL);
                            }});
                            0x2: c_zext_h({{
                                Rp1 = Rp1 & 0xFFFFULL;
                            }});
                            0x3: c_sext_h({{
                                Rp1 = sext<16>(Rp1 & 0xFFFFULL);
                            }});
                            0x4: decode RVTYPE {
                                0x1: c_zext_w({{
                                    Rp1 = bits(Rp1, 31, 0);
                                }});
                            }
                            0x5: c_not({{
                                Rp1 = ~Rp1;
                            }});
                        }
                    }
                }
            }
        }
        0x5: CJOp::c_j({{
            NPC = rvZext(PC + imm);
        }}, IsDirectControl, IsUncondControl);
        format CBOp {
            0x6: c_beqz({{
                if (rvSext(Rp1) == 0)
                    NPC = rvZext(PC + imm);
                else
                    NPC = NPC;
            }}, IsDirectControl, IsCondControl);
            0x7: c_bnez({{
                if (rvSext(Rp1) != 0)
                    NPC = rvZext(PC + imm);
                else
                    NPC = NPC;
            }}, IsDirectControl, IsCondControl);
        }
    }
    0x2: decode COPCODE {
        0x0: CIOp::c_slli({{
            imm = CIMM5 | (CIMM1 << 5);
        }}, {{
            if (rvSelect((bool)CIMM1, false)) {
                return std::make_shared<IllegalInstFault>(
                        "shmat[5] != 0", machInst);
            }
            if (imm == 0) {
                // C.SLLI64, HINT for RV32/RV64
            }
            // RC1 == 0 is HINT
            Rc1 = rvSext(Rc1 << imm);
        }}, uint64_t);
        format CompressedLoad {
            // PURECAP: this encoding (C2, funct3=001) is c.lqsp (load 128-bit
            // capability from sp), NOT c.fldsp. Route it through the CapLoad
            // format so it does a 16-byte cap load + tag lookup, writing the
            // capability destination register Cc1 (bits[11:7]). Without this,
            // capability spills (every function prologue restores cra/cs*) were
            // decoded as 8-byte float loads and corrupted returns.
            0x1: CapLoad::c_lqsp({{
                Cc1 = _loadedCap;
            }},
                ea_code = {{
                    EA = rvZext(sp + offset);
                }},
                cap_check_code = {{ }},
                offset_code = {{
                    // c.lqsp uimm: [5]=inst[12], [4]=inst[6], [9:6]=inst[5:2]
                    offset = (CIMM1 << 5) | (CIMM5<4:4> << 4) |
                             (CIMM5<3:0> << 6);
                }});
            0x2: c_lwsp({{
                offset = CIMM5<4:2> << 2 |
                         CIMM1 << 5 |
                         CIMM5<1:0> << 6;
            }}, {{
                if (RC1 == 0) {
                    return std::make_shared<IllegalInstFault>(
                            "source reg x0", machInst);
                }
                Rc1_sw = Mem_sw;
            }}, {{
                EA = rvZext(sp + offset);
            }});
            0x3: decode RVTYPE {
                0x0: c_flwsp({{
                    offset = CIMM5<4:2> << 2 |
                             CIMM1 << 5 |
                             CIMM5<1:0> << 6;
                }}, {{
                    STATUS status = xc->readMiscReg(MISCREG_STATUS);
                    if (status.fs == FPUStatus::OFF)
                        return std::make_shared<IllegalInstFault>("FPU is off",
                                                                   machInst);

                    status.fs = FPUStatus::DIRTY;
                    xc->setMiscReg(MISCREG_STATUS, status);

                    freg_t fd;
                    fd = freg(f32(Mem_uw));
                    Fc1_bits = fd.v;
                }}, {{
                    EA = (uint32_t)(sp_uw + offset);
                }});
                0x1: c_ldsp({{
                    offset = CIMM5<4:3> << 3 |
                             CIMM1 << 5 |
                             CIMM5<2:0> << 6;
                }}, {{
                    if (RC1 == 0) {
                        return std::make_shared<IllegalInstFault>(
                                "source reg x0", machInst);
                    }
                    Rc1_sd = Mem_sd;
                }}, {{
                    EA = sp + offset;
                }});
            }
        }
        0x4: decode CFUNCT1 {
            0x0: decode RC2 {
                0x0: CJump::c_jr({{
                    // if (RC1 == 0) {
                    //     return std::make_shared<IllegalInstFault>(
                    //             "source reg x0", machInst);
                    // }
                    // NPC = rvZext(Rc1 & (~0x1));
                    using namespace gem5::CHERIRiscvISA;

                    // Pure-cap: cs1 names a capability register
                    const uint32_t cs1_idx = bits(machInst, 11, 7);
                    if (cs1_idx == 0) {
                        return std::make_shared<IllegalInstFault>(
                            "c_jalr with cnull source", machInst);
                    }

                    CapRegContainer _target;
                    xc->tcBase()->getReg(capRegClass[cs1_idx], &_target);

                    if (!_target.getTag()) {
                        // ── Bring-up: c.jr to an UNTAGGED target ──
                        // Real CHERI-RISC-V raises a tag-violation fault here.
                        // The empty stub used to do NEITHER jump nor fault, so
                        // c.jr silently FELL THROUGH to PC+2 -- a loop function's
                        // `c.jr cra` ran into adjacent code with stale registers,
                        // giving a bogus struct pointer and a misaligned clc /
                        // SIGBUS in userspace startup. During bring-up we jump to
                        // the target ADDRESS anyway (a merely-detagged but
                        // otherwise-valid return/function cap still transfers
                        // control), matching the relaxed checks elsewhere.
                        // warn_once surfaces the upstream tag loss to fix later.
                        warn_once("c_jr: untagged target c%d addr=%#lx meta=%#lx;"
                            " jumping anyway (bring-up)\n", cs1_idx,
                            (unsigned long)_target.getAddress(),
                            (unsigned long)(uint64_t)_target.getMetadata());
                        // The bare-integer target (meta=0) has no bounds/exec perm.
                        // Re-home it on the CURRENT PCC (a valid executable cap) at
                        // the target address, so the resulting PCC stays usable for
                        // fetch and PC-relative derivation.
                        {
                            Addr _taddr = _target.getAddress();
                            _target = xc->pcState().as<PCState>().pcc();
                            _target.setAddress(_taddr);
                        }
                    }
                    {
                        const PCStateBase &pcBaseConst = xc->pcState();
                        const PCState &pc_state_in = pcBaseConst.as<PCState>();

                        Addr inst_pc = pc_state_in.instAddr();
                        Addr target_addr = _target.getAddress() & ~1ULL;

                        DPRINTF(CheriDecode,
                            "c_jr ENTRY: inst_pc=0x%lx, target=0x%lx, "
                            "cs1_idx=%d, cs1.addr=0x%lx, cs1.tag=%d\n",
                            inst_pc, target_addr, cs1_idx,
                            _target.getAddress(), _target.getTag());

                        // NOTE: c.jr is a pure jump (jalr x0, 0(rs1)); it must
                        // NOT write a link register. Only c.jalr links to cra.
                        // (Previously this clobbered cra on every c.jr, which
                        // corrupted all subsequent returns.)

                        // ── Build new PCC from target capability ──
                        CapRegContainer new_pcc = _target;
                        new_pcc.setAddress(target_addr);
                        CAPTYPE new_meta = new_pcc.getMetadata();
                        if (new_meta.otype == ((1ULL << 18) - 2)) {
                            new_meta.otype = (1ULL << 18) - 1;  // unseal sentry
                            new_pcc.setMetadata(new_meta);
                        }

                        // ── Build new PCState and write back ──
                        PCState new_pc_state = pc_state_in;     // copy via copy-ctor
                        new_pc_state.pcc(new_pcc);
                        new_pc_state.set(target_addr);
                        new_pc_state.npc(target_addr);
                        xc->pcState(new_pc_state);

                        DPRINTF(CheriDecode,
                            "c_jr POST: inst_pc=0x%lx, npc=0x%lx, pcc.addr=0x%lx\n",
                            new_pc_state.instAddr(), new_pc_state.npc(),
                            new_pc_state.pcc().getAddress());
                        }
                }}, IsIndirectControl, IsUncondControl);
                default: CROp::c_mv({{
                    // RC1 == 0 is HINT
                    Rc1 = rvSext(Rc2);
                }});
            }
            0x1: decode RC2 {
                0x0: decode RC1 {
                    0x0: SystemOp::c_ebreak({{
                        // NB: Semihosting spec requires uncompressed ebreak,
                        // so this instruction does not check for semihosting.
                        return std::make_shared<BreakpointFault>(
                            xc->pcState());
                    }}, IsSerializeAfter, IsNonSpeculative, No_OpClass);
                    default: CJump::c_jalr({{
                        using namespace gem5::CHERIRiscvISA;

                        // Pure-cap: cs1 names a capability register
                        const uint32_t cs1_idx = bits(machInst, 11, 7);
                        if (cs1_idx == 0) {
                            return std::make_shared<IllegalInstFault>(
                                "c_jalr with cnull source", machInst);
                        }

                        CapRegContainer _target;
                        xc->tcBase()->getReg(capRegClass[cs1_idx], &_target);

                        if (!_target.getTag()) {
                            // ── Bring-up: c.jalr to an UNTAGGED target ──
                            // Same empty-stub fall-through bug as c.jr (see above):
                            // real CHERI faults, the stub did nothing, so the call
                            // silently fell through to PC+2. Jump to the target
                            // address anyway during bring-up and surface the loss.
                            warn_once("c_jalr: untagged target c%d addr=%#lx meta=%#lx;"
                                " jumping anyway (bring-up)\n", cs1_idx,
                                (unsigned long)_target.getAddress(),
                                (unsigned long)(uint64_t)_target.getMetadata());
                            // Re-home the bare-integer target on the current PCC
                            // (valid executable cap) at the target address; see c_jr.
                            {
                                Addr _taddr = _target.getAddress();
                                _target = xc->pcState().as<PCState>().pcc();
                                _target.setAddress(_taddr);
                            }
                        }
                        {
                            const PCStateBase &pcBaseConst = xc->pcState();
                            const PCState &pc_state_in = pcBaseConst.as<PCState>();

                            Addr inst_pc = pc_state_in.instAddr();
                            Addr ret_addr = inst_pc + 2;                       // c.jalr is 2 bytes
                            Addr target_addr = _target.getAddress() & ~1ULL;

                            DPRINTF(CheriDecode,
                                "c_jalr ENTRY: inst_pc=0x%lx, ret_addr=0x%lx, target=0x%lx, "
                                "cs1_idx=%d, cs1.addr=0x%lx, cs1.tag=%d\n",
                                inst_pc, ret_addr, target_addr, cs1_idx,
                                _target.getAddress(), _target.getTag());

                            // ── Build return capability ──
                            CapRegContainer current_pcc = pc_state_in.pcc();
                            CapRegContainer ret_cap = current_pcc;
                            CAPTYPE ret_meta = current_pcc.getMetadata();
                            ret_meta.otype = (1ULL << 18) - 2;  // sentry
                            ret_cap.setMetadata(ret_meta);
                            ret_cap.setAddress(ret_addr);

                            // Write return cap to c1 (cra) manually
                            xc->tcBase()->setReg(capRegClass[1], &ret_cap);

                            // ── Build new PCC from target capability ──
                            CapRegContainer new_pcc = _target;
                            new_pcc.setAddress(target_addr);
                            CAPTYPE new_meta = new_pcc.getMetadata();
                            if (new_meta.otype == ((1ULL << 18) - 2)) {
                                new_meta.otype = (1ULL << 18) - 1;  // unseal sentry
                                new_pcc.setMetadata(new_meta);
                            }

                            // ── Build new PCState and write back ──
                            PCState new_pc_state = pc_state_in;     // copy via copy-ctor
                            new_pc_state.pcc(new_pcc);
                            new_pc_state.set(target_addr);
                            new_pc_state.npc(target_addr);
                            xc->pcState(new_pc_state);

                            DPRINTF(CheriDecode,
                                "c_jalr POST: inst_pc=0x%lx, npc=0x%lx, pcc.addr=0x%lx\n",
                                new_pc_state.instAddr(), new_pc_state.npc(),
                                new_pc_state.pcc().getAddress());
                        }
                    }}, IsIndirectControl, IsUncondControl, IsCall);
                }
                default: CompressedROp::c_add({{
                    // RC1 == 0 is HINT
                    Rc1_sd = rvSext(Rc1_sd + Rc2_sd);
                }});
            }
        }
        format CompressedStore {
            // PURECAP: this encoding (C2, funct3=101) is c.sqsp (store 128-bit
            // capability to sp), NOT c.fsdsp. Route through CapStore for a
            // 16-byte cap store + tag, from source cap register Cc2 (bits[6:2]).
            0x5: CapStore::c_sqsp({{
                _storeCap = Cc2;
            }},
                ea_code = {{
                    EA = rvZext(sp + offset);
                }},
                cap_check_code = {{ }},
                offset_code = {{
                    // c.sqsp uimm: [5:4]=inst[12:11], [9:6]=inst[10:7]
                    offset = (CIMM6<5:4> << 4) | (CIMM6<3:0> << 6);
                }});
            0x6: c_swsp({{
                offset = CIMM6<5:2> << 2 |
                         CIMM6<1:0> << 6;
            }}, {{
                Mem_uw = Rc2_uw;
            }}, {{
                EA = rvZext(sp + offset);
            }});
            0x7: decode RVTYPE {
                0x0: c_fswsp({{
                    offset = CIMM6<5:2> << 2 |
                             CIMM6<1:0> << 6;
                }}, {{
                    STATUS status = xc->readMiscReg(MISCREG_STATUS);
                    if (status.fs == FPUStatus::OFF)
                        return std::make_shared<IllegalInstFault>("FPU is off",
                                                                   machInst);

                    Mem_uw = unboxF32(boxF32(Fc2_bits));
                }}, {{
                    EA = (uint32_t)(sp_uw + offset);
                }});
                0x1: c_sdsp({{
                    offset = CIMM6<5:3> << 3 |
                             CIMM6<2:0> << 6;
                }}, {{
                    Mem = Rc2;
                }}, {{
                    EA = sp + offset;
                }});
            }
        }
    }
    0x3: decode OPCODE5 {
        0x00: decode FUNCT3 {
            // format Load {
            //     0x0: lb({{
            //         Rd_sd = Mem_sb;
            //     }});
            //     0x1: lh({{
            //         Rd_sd = Mem_sh;
            //     }});
