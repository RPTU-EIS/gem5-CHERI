                                if (!cond1_t && !cond2_t) c_t = 0;
                                else if (!cond1_t && cond2_t) c_t = 1;
                                else if (cond1_t && !cond2_t) c_t = -1;
                                else c_t = 0;
                                
                                uint64_t a_top = (a >> (E + 14));
                                uint64_t base = ((a_top + c_b) << (E + 14)) | (B << E);
                                uint64_t top = ((a_top + c_t) << (E + 14)) | (T << E);
                                
                                // Increment address (Rs2 is treated as signed)
