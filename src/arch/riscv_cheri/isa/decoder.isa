                            RegIndex rs2Idx = RS2 + int_reg::_ZeroIdx;
                            RegIndex dstIdx = CD + cap_reg::_CNullIdx;

                            DPRINTF(CheriDecode, "Setting offset for c%d from c%d with offset from x%d\n",
                                dstIdx, cs1Idx, rs2Idx);

                            // Copy source capability
                            Cd = Cs1;
                            
                            if (!Cs1.getTag()) {
                                Cd.setTag(false);
                                DPRINTF(CheriDecode, "Source capability invalid, clearing tag\n");
                            } else {
                                uint64_t a = Cs1.getAddress();
                                CAPTYPE meta = Cs1.getMetadata();
                                
                                // Decode base to calculate new address from offset
                                uint64_t B_hi = meta.B;
                                uint64_t T_hi = meta.T;
                                uint64_t B_E = meta.BE;
                                uint64_t T_E = meta.TE;
                                uint64_t I_E = meta.IE;
                                
                                uint64_t E, B, T, L_carry_out, L_msb;
                                
                                if (I_E == 0) {
                                    E = 0;
                                    T = (T_hi << 3) | T_E;
                                    B = (B_hi << 3) | B_E;
                                    L_carry_out = (T < (B & 0xFFF)) ? 1 : 0;
                                    L_msb = 0;
                                } else {
                                    E = (T_E << 3) | B_E;
                                    T = T_hi << 3;
                                    B = B_hi << 3;
                                    L_carry_out = (T < (B & 0xFFF)) ? 1 : 0;
                                    L_msb = 1;
                                }
                                
                                uint64_t B_top2 = (B >> 12) & 0x3;
                                T |= ((B_top2 + L_carry_out + L_msb) & 0x3) << 12;
                                
                                uint64_t A_3 = (a >> (E + 11)) & 0x7;
                                uint64_t B_3 = (B >> 11) & 0x7;
                                uint64_t T_3 = (T >> 11) & 0x7;
                                uint64_t R = (B_3 - 1) & 0x7;
                                
                                // Calculate base correction
                                int64_t c_b;
                                bool cond1_b = (A_3 < R);
                                bool cond2_b = (B_3 < R);
                                if (!cond1_b && !cond2_b) c_b = 0;
                                else if (!cond1_b && cond2_b) c_b = 1;
                                else if (cond1_b && !cond2_b) c_b = -1;
                                else c_b = 0;
                                
                                // Calculate top correction
                                int64_t c_t;
                                bool cond1_t = (A_3 < R);
                                bool cond2_t = (T_3 < R);
                                if (!cond1_t && !cond2_t) c_t = 0;
                                else if (!cond1_t && cond2_t) c_t = 1;
                                else if (cond1_t && !cond2_t) c_t = -1;
                                else c_t = 0;
                                
                                uint64_t a_top = (a >> (E + 14));
                                uint64_t base = ((a_top + c_b) << (E + 14)) | (B << E);
                                uint64_t top = ((a_top + c_t) << (E + 14)) | (T << E);
                                
                                // Calculate new address from offset
                                uint64_t offset = Rs2;
                                uint64_t new_addr = base + offset;
                                
                                // Check bounds
                                if (new_addr < base || new_addr >= top) {
                                    Cd.setTag(false);
                                    DPRINTF(CheriDecode, "New address out of bounds, clearing tag\n");
                                } else {
                                    Cd.setAddress(new_addr);
                                    DPRINTF(CheriDecode, "Set address to %#llx (base=%#llx, offset=%#llx)\n",
                                            (unsigned long long)new_addr,
                                            (unsigned long long)base,
                                            (unsigned long long)offset);
                                    
                                    xc->tcBase()->setReg(intRegClass[CD], new_addr);
                                }
                            }
                        }});
                    }

                    format COp {
                        0x10: csetaddr({{
                            using namespace gem5::CHERIRiscvISA;

                            RegIndex cs1Idx = CS1 + cap_reg::_CNullIdx;
                            RegIndex rs2Idx = RS2 + int_reg::_ZeroIdx;
                            RegIndex dstIdx = CD + cap_reg::_CNullIdx;

                            DPRINTF(CheriDecode, "Setting address for c%d from c%d with address from x%d\n",
                                dstIdx, cs1Idx, rs2Idx);

                            // Copy source capability
                            Cd = Cs1;

                            if (!Cs1.getTag()) {
                                // CSetAddr sets the address to Rs2 regardless of
                                // tag; for an untagged source the result is just
                                // an untagged pointer with the new address.
                                uint64_t new_addr = Rs2;
                                Cd.setAddress(new_addr);
                                Cd.setTag(false);
                                xc->tcBase()->setReg(intRegClass[CD], new_addr);
                                DPRINTF(CheriDecode, "Untagged source: set address -> %#llx (tag cleared)\n",
                                        (unsigned long long)new_addr);
                            }
                            else {
                                uint64_t a = Cs1.getAddress();
                                CAPTYPE meta = Cs1.getMetadata();

                                // Decode bounds
                                uint64_t B_hi = meta.B;
                                uint64_t T_hi = meta.T;
                                uint64_t B_E = meta.BE;
                                uint64_t T_E = meta.TE;
                                uint64_t I_E = meta.IE;

                                uint64_t E, B, T, L_carry_out, L_msb;

                                if (I_E == 0) {
                                    E = 0;
                                    T = (T_hi << 3) | T_E;
                                    B = (B_hi << 3) | B_E;
                                    L_carry_out = (T < (B & 0xFFF)) ? 1 : 0;
                                    L_msb = 0;
                                } else {
                                    E = (T_E << 3) | B_E;
                                    T = T_hi << 3;
                                    B = B_hi << 3;
                                    L_carry_out = (T < (B & 0xFFF)) ? 1 : 0;
                                    L_msb = 1;
                                }
                                
                                uint64_t B_top2 = (B >> 12) & 0x3;
                                T |= ((B_top2 + L_carry_out + L_msb) & 0x3) << 12;
                                
                                uint64_t A_3 = (a >> (E + 11)) & 0x7;
                                uint64_t B_3 = (B >> 11) & 0x7;
                                uint64_t T_3 = (T >> 11) & 0x7;
                                uint64_t R = (B_3 - 1) & 0x7;
                                
                                int64_t c_b;
                                bool cond1_b = (A_3 < R);
                                bool cond2_b = (B_3 < R);
                                if (!cond1_b && !cond2_b) c_b = 0;
                                else if (!cond1_b && cond2_b) c_b = 1;
                                else if (cond1_b && !cond2_b) c_b = -1;
                                else c_b = 0;
                                
                                int64_t c_t;
                                bool cond1_t = (A_3 < R);
                                bool cond2_t = (T_3 < R);
                                if (!cond1_t && !cond2_t) c_t = 0;
                                else if (!cond1_t && cond2_t) c_t = 1;
                                else if (cond1_t && !cond2_t) c_t = -1;
                                else c_t = 0;
                                
                                uint64_t a_top = (a >> (E + 14));
                                uint64_t base = ((a_top + c_b) << (E + 14)) | (B << E);
                                uint64_t top = ((a_top + c_t) << (E + 14)) | (T << E);
                                
                                // Set new address
                                uint64_t new_addr = Rs2;
                                
                                // Check bounds
                                // if (new_addr < base || new_addr >= top) {
                                //     Cd.setTag(false);
                                //     DPRINTF(CheriDecode, "New address %#llx out of bounds (%#llx, %#llx), clearing tag\n",
                                //             (unsigned long long)new_addr,
                                //             (unsigned long long)base,
                                //             (unsigned long long)top);
                                // } else {
                                //     Cd.setAddress(new_addr);
                                //     DPRINTF(CheriDecode, "Set address to %#llx\n",
                                //             (unsigned long long)new_addr);
                                // }

                                Cd.setAddress(new_addr);
                                    DPRINTF(CheriDecode, "Set address (bounds check skipped) to %#llx\n",
                                            (unsigned long long)new_addr);
                                
                                xc->tcBase()->setReg(intRegClass[CD], new_addr);
                            }
                        }});
                    } 

                    format COp {
