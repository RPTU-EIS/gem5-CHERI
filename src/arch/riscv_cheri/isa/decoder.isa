                        0x0f: csetoffset({{
                            Cd = cheriResult(xc, capSetAddr(Cs1,
                                capGetBase(Cs1) + Rs2), Cs1.getTag());
                        }});
                    }

                    format COp {
                        0x10: csetaddr({{
                            Cd = cheriResult(xc, capSetAddr(Cs1, Rs2),
                                Cs1.getTag());
                        }});
                    }

                    format COp {
                        0x11: cincoffset({{
                            Cd = cheriResult(xc, capSetAddr(Cs1,
                                Cs1.getAddress() + Rs2), Cs1.getTag());
                        }});
                    }

                    format COp {
                        0x12: ctoptr({{
                            // CToPtr rd, cs1, cs2 (c0 = DDC): offset of cs1
                            // from cs2's base, or 0 if
                            // cs1 is untagged.
                            CapRegContainer _ctp = CS2 == 0
                                ? cheriDdc(xc) : Cs2;
                            Rd = Cs1.getTag()
                                ? Cs1.getAddress() - capGetBase(_ctp) : 0;
                        }});
                    }

                    format COp {
                        0x13: cfromptr({{
                            // CFromPtr cd, cs1 (c0 = DDC), rs2: null if rs2 ==
                            // 0, else cs1 with offset
                            // rs2 (tag cleared if sealed or not
                            // representable).
                            CapRegContainer _auth = CS1 == 0
                                ? cheriDdc(xc) : Cs1;
                            if (Rs2 == 0) {
                                Cd = CapRegContainer();
                            } else {
                                Cd = cheriResult(xc, capSetAddr(_auth,
                                    capGetBase(_auth) + Rs2),
                                                 _auth.getTag());
                            }
                        }});
                    }

                    format COp {
                        0x16: csethigh({{
                            // CSetHigh: replace the metadata half; the result
                            // is always untagged.
                            CapRegContainer _r = Cs1;
                            _r.setMetadata(Rs2);
                            _r.setTag(false);
                            Cd = _r;
                        }});
                    }

                    format COp {
                        0x1d: cbuildcap({{
                            // CBuildCap cd, cs1 (authority; c0 = DDC), cs2.
                            Cd = capBuild(CS1 == 0 ? cheriDdc(xc) : Cs1, Cs2);
                        }});
                    }

                    format COp {
                        0x1e: ccopytype({{
                            Cd = capCopyType(Cs1, Cs2);
                        }});
                    }

                    format COp {
                        0x1f: ccseal({{
                            Cd = capCSeal(Cs1, Cs2);
                        }});
                    }

                    format COp {
                        0x20: ctestsubset({{
                            // CTestSubset rd, cs1 (c0 = DDC), cs2.
                            Rd = capTestSubset(CS1 == 0 ? cheriDdc(xc) : Cs1,
                                Cs2) ? 1 : 0;
                        }});
                    }

                    format COp {
                        0x21: csetequalexact({{
                            Rd = (Cs1.getTag() == Cs2.getTag() &&
                                  Cs1.getAddress() == Cs2.getAddress() &&
                                  capPesbt(Cs1.getMetadata())
                                      == capPesbt(Cs2.getMetadata())) ? 1 : 0;
                        }});
                    }

                    format COp {
                        0x7f: decode CAPFUN {
                        0x00: cgetperm({{
                            Rd = capArchPerms(Cs1);
                        }});

                        0x01: cgettype({{
                            Rd = capGetType(Cs1);
                        }});

                        0x02: cgetbase({{
                            Rd = capGetBase(Cs1);
                        }});

                        0x03: cgetlen({{
                            Rd = capGetLen(Cs1);
                        }});

                        0x04: cgettag({{
                            Rd = Cs1.getTag() ? 1 : 0;
                        }});

                        0x05: cgetsealed({{
                            Rd = capIsSealed(Cs1) ? 1 : 0;
                        }});

                        0x06: cgetoffset({{
                            Rd = Cs1.getAddress() - capGetBase(Cs1);
                        }});

                        0x07: cgetflags({{
                            Rd = CAPTYPE(capPesbt(Cs1.getMetadata())).flag;
                        }});

                        0x17: cgethigh({{
                            Rd = Cs1.getMetadata();
                        }});

                        0x18: cgettop({{
                            Rd = capGetTop(Cs1);
                        }});

                        0x08: croundrepresentablelength({{
                            using namespace gem5::CHERIRiscvISA;

                            RegIndex rs1Idx = RS1 + int_reg::_ZeroIdx;
                            RegIndex dstIdx = RD + int_reg::_ZeroIdx;

                                DPRINTF(CheriDecode, "Rounding length from x%d to representable value and storing in x%d\n", rs1Idx, dstIdx);

                            uint64_t req_length = Rs1;

                            // Use the shared reference-consistent rounding so
                            // CRRL agrees with CSetBounds (the kernel rounds a
                            // length here, aligns the base with CRAM below, then
                            // asserts CSetBounds produced exactly this length).
                            uint64_t rounded_length = cc128RoundLength(req_length);
                            Rd = rounded_length;

                            DPRINTF(CheriDecode, "Rounded length from %#llx to %#llx\n",
                                (unsigned long long)req_length,
                                (unsigned long long)rounded_length);
                        }});

                        0x09: crepresentablealignmentmask({{
                            using namespace gem5::CHERIRiscvISA;

                            RegIndex rs1Idx = RS1 + int_reg::_ZeroIdx;
                            RegIndex dstIdx = RD + int_reg::_ZeroIdx;

                                DPRINTF(CheriDecode, "Getting alignment mask for length from x%d and storing in x%d\n", rs1Idx, dstIdx);

                            uint64_t req_length = Rs1;

                            // CRepresentableAlignmentMask returns a mask such
                            // that (addr & mask) rounds addr DOWN to a base that
                            // can hold an exact-bounds capability of req_length.
                            // Uses the same reference cc128 exponent/incE logic
                            // as CSetBounds and CRRL so the three stay consistent.
                            uint64_t mask = cc128AlignMask(req_length);
                            Rd = mask;

                            DPRINTF(CheriDecode, "Alignment mask = %#llx\n",
                                (unsigned long long)mask);
                        }});

                        0x0A: cmove({{
                            Cd = Cs1;
                        }});

                        0x0b: ccleartag({{
                            using namespace gem5::CHERIRiscvISA;

                            RegIndex cs1Idx = CS1 + cap_reg::_CNullIdx;
                            RegIndex dstIdx = CD + cap_reg::_CNullIdx;

                            DPRINTF(CheriDecode, "Clearing tag of c%d and storing in c%d\n", cs1Idx, dstIdx);

                            // Copy capability but clear the tag
                            Cd = Cs1;
                            Cd.setTag(false);

                                DPRINTF(CheriDecode, "Cleared tag (addr=%#llx preserved)\n", (unsigned long long)Cs1.getAddress());
                        }});

                        0x0c: jalr_cap({{
                            // CJALR cd, cs1 (explicit capability encoding).
                            CapRegContainer _link;
                            if (Fault _f = cheriIndirectJump(xc, Cs1, CS1, 0,
                                    xc->pcState().instAddr() + 4, &_link))
                                return _f;
                            Cd = _link;
                        }}, IsControl, IsIndirectControl, IsUncondControl);

                        // 0x0c: jalr_cap({{
                        //     using namespace gem5::CHERIRiscvISA;

                        //     DPRINTF(CheriDecode, "JALR.CAP: cd=c%d cs1=c%d\n",
                        //             CD + cap_reg::_CNullIdx, CS1 + cap_reg::_CNullIdx);

                        //     // Check cs1 validity
                        //     if (!Cs1.getTag()) {
                        //         // Raise exception
                        //         // fault = std::make_shared<CheriCapException>(CapEx_TagViolation, CS1);
                        //     } else {
                        //         // Get current PCC
                        //         PCState pc_state;
                        //         set(pc_state, xc->pcState());
                        //         CapRegContainer current_pcc = pc_state.pcc();

                        //         // Create return capability (sealed as sentry)
                        //         Cd = current_pcc;
                        //         CAPTYPE meta = current_pcc.getMetadata();
                        //         meta.otype = (1ULL << 18) - 2;  // Sentry otype
                        //         Cd.setMetadata(meta);
                        //         Cd.setAddress(pc_state.npc());

                        //         // Update PCC to cs1
                        //         CapRegContainer new_pcc = Cs1;
                        //         uint64_t target = Cs1.getAddress() & ~1ULL;
                        //         new_pcc.setAddress(target);

                        //         // Unseal if sentry
                        //         meta = new_pcc.getMetadata();
                        //         if (meta.otype == ((1ULL << 18) - 2)) {
                        //             meta.otype = (1ULL << 18) - 1;  // Unsealed
                        //             new_pcc.setMetadata(meta);
                        //         }

                        //         // Update PC state
                        //         pc_state.pcc(new_pcc);
                        //         pc_state.set(target);
                        //         xc->pcState(pc_state);

                        //         DPRINTF(CheriDecode, "JALR.CAP: jumping to 0x%x\n", target);
                        //     }

                        // }});

                        0x0e: cclear({{
                            using namespace gem5::CHERIRiscvISA;

                            RegIndex dstIdx = CD + cap_reg::_CNullIdx;

                            DPRINTF(CheriDecode, "Clearing c%d\n", dstIdx);

                            // Clear capability - set to NULL (all zeros with tag cleared)
                            Cd.setTag(false);
                            Cd.setAddress(0);
                            Cd.setMetadata(0);

                            DPRINTF(CheriDecode, "Cleared capability to NULL\n");
                        }});

                        0x10: fpclear({{
                            using namespace gem5::CHERIRiscvISA;

                            RegIndex rs1Idx = RS1 + int_reg::_ZeroIdx;

                            DPRINTF(CheriDecode, "Clearing floating point registers based on mask in x%d\n", rs1Idx);

                            // Get mask of which FP registers to clear
                            uint64_t mask = Rs1;

                            // Clear floating point registers according to mask
                            // Each bit in mask corresponds to one FP register (bits 0-31)
                            for (int i = 0; i < 32; i++) {
                                if (mask & (1ULL << i)) {
                                    // Clear FP register i
                                    RegId fp_reg = floatRegClass[i];
                                    xc->setRegOperand(this, 0, (RegVal)0);  // Set to zero
                                    DPRINTF(CheriDecode, "Cleared f%d\n", i);
                                }
                            }

                            DPRINTF(CheriDecode, "Cleared FP registers with mask %#llx\n", (unsigned long long)mask);
                        }});

                        0x11: csealentry({{
                            Cd = capSealEntry(Cs1);
                        }});

                        0x12: cloadtags({{

                            using namespace gem5::CHERIRiscvISA;

                            RegIndex cs1Idx = CS1 + cap_reg::_CNullIdx;
                            RegIndex dstIdx = RD + int_reg::_ZeroIdx;

                            DPRINTF(CheriDecode, "Loading tags from memory at c%d and storing in x%d\n", cs1Idx, dstIdx);

                            uint64_t vaddr = Cs1.getAddress();
                            const uint64_t caps_per_cache_line = 8;
                            const uint64_t cap_size = 16;  // 128-bit capability
                            const uint64_t access_length =
                                caps_per_cache_line * cap_size;

                            // Sail CLoadTags: tag, seal, PERMIT_LOAD,
                            // PERMIT_LOAD_CAP, bounds, then alignment. (Early
                            // kernel caps don't carry correct perms yet, so
                            // this
                            // is only enforced where cheriEnforcing() is
                            // true.)
                            if (Fault _f = CHERIRiscvISA::capEnforce(
                                    xc->tcBase(),
                                    capCheckMemAccess(Cs1, vaddr,
                                        access_length,
                                        CheriAccLoad | CheriAccLoadTags),
                                    CS1, vaddr))
                                return _f;
                            if (CHERIRiscvISA::cheriEnforcing(xc->tcBase()) &&
                                    (vaddr & (access_length - 1)) != 0) {
                                return std::make_shared<AddressFault>(vaddr,
                                    ExceptionCode::LOAD_ADDR_MISALIGNED);
                            }

                            // cloadtags is a register-format instruction so it
                            // does not go through the load/store translation
                            // path; translate the virtual address ourselves. The
                            // tag table is keyed by physical address, the same
                            // way clc/csc read/write tags in cap_mem.isa.
                            auto *ctc = xc->tcBase();
                            // Use the virtual-address Request constructor (sets
                            // VALID_VADDR); the 4-arg form builds a PHYSICAL
                            // request and translateFunctional()'s getVaddr()
                            // would assert.
                            RequestPtr treq = std::make_shared<Request>(
                                vaddr, access_length, Request::Flags(),
                                Request::funcRequestorId, /*pc*/0,
                                ctc->contextId());
                            Fault tf = ctc->getMMUPtr()->translateFunctional(
                                treq, ctc, BaseMMU::Read);
                            uint64_t tag_bits = 0;
                            Addr pa = vaddr;
                            System *csys = ctc->getSystemPtr();
                            bool clear_tags = false;
                            if (tf == NoFault &&
                                    CHERIRiscvISA::cheriEnforcing(ctc)) {
                                auto *mmu = static_cast<CHERIRiscvISA::MMU *>(
                                    ctc->getMMUPtr());
                                if (Fault f = mmu->checkCheriPteFunctional(
                                        ctc, vaddr, BaseMMU::Read, true,
                                        false, clear_tags))
                                    return f;
                            }
                            if (tf == NoFault) {
                                pa = treq->getPaddr();
                            } else if (CHERIRiscvISA::cheriEnforcing(ctc)) {
                                // A real access would take this page fault.
                                return tf;
                            } else {
                                // Bring-up: this early cloadtags targets a
                                // PHYSICAL address (e.g. 0x80204b00, in the DRAM
                                // range where the kernel is loaded) that is not
                                // mapped in the current page table, so translation
                                // faults. Fall back to treating the capability
                                // address as physical (identity) -- the tags for
                                // that region are already in the table.
                                pa = vaddr;
                                DPRINTF(CheriDecode, "cloadtags translate failed for vaddr %#llx, using identity pa\n", (unsigned long long)vaddr);
                            }
                            for (uint64_t i = 0;
                                    !clear_tags && i < caps_per_cache_line;
                                    i++) {
                                if (csys->cheritagtable.getTag(pa + i * cap_size))
                                    tag_bits |= (1ULL << i);
                            }

                            DPRINTF(CheriDecode, "Loaded tag bits = %#llx from vaddr %#llx (pa-based)\n", (unsigned long long)tag_bits, (unsigned long long)vaddr);
                            Rd = tag_bits;

                        }}, IsNonSpeculative);

                        0x14: jalr_pcc({{
                            // JALR.PCC rd, rs1 (Sail JALR_PCC = RISCV_JALR):
                            // integer jump to rs1 & ~1 within the current
                            // PCC, checked against PCC at the jump; the
                            // integer return address goes to rd.
                            Addr _target = Rs1 & ~Addr(1);
                            if (Fault _f = cheriCheckBranch(xc, _target))
                                return _f;
                            Rd = NPC;
                            NPC = _target;
                        }}, IsIndirectControl, IsUncondControl);

                    }
                    }


                    // Explicit stores (CheriStore_r, funct7 0x7c): the
                    // operation is in the rd field, data in rs2, no offset.
                    // .ddc: integer address rs1 authorised by DDC; .cap:
                    // authorising capability cs1.
                    0x7c: decode RD {
                        format CapDataStore {
                            0x00: sb_ddc({{
                                Mem_ub = Rs2_ub;
                            }},
                            ea_code = {{ EA = rvZext(Rs1); }},
                            cap_check_code = {{
                                CHERI_CHECK_MEM_DDC(EA, 1, CheriAccStore);
                            }},
                            offset_code = {{ offset = 0; }});
                            0x01: sh_ddc({{
                                Mem_uh = Rs2_uh;
                            }},
                            ea_code = {{ EA = rvZext(Rs1); }},
                            cap_check_code = {{
                                CHERI_CHECK_MEM_DDC(EA, 2, CheriAccStore);
                            }},
                            offset_code = {{ offset = 0; }});
                            0x02: sw_ddc({{
                                Mem_uw = Rs2_uw;
                            }},
                            ea_code = {{ EA = rvZext(Rs1); }},
                            cap_check_code = {{
                                CHERI_CHECK_MEM_DDC(EA, 4, CheriAccStore);
                            }},
                            offset_code = {{ offset = 0; }});
                            0x03: sd_ddc({{
                                Mem_ud = Rs2_ud;
                            }},
                            ea_code = {{ EA = rvZext(Rs1); }},
                            cap_check_code = {{
                                CHERI_CHECK_MEM_DDC(EA, 8, CheriAccStore);
                            }},
                            offset_code = {{ offset = 0; }});
                            0x08: sb_cap_x({{
                                Mem_ub = Rs2_ub;
                            }},
                            ea_code = {{ EA = rvZext(Cs1.getAddress()); }},
                            cap_check_code = {{
                                CHERI_CHECK_MEM(Cs1, CS1, EA, 1, CheriAccStore);
                            }},
                            offset_code = {{ offset = 0; }});
                            0x09: sh_cap_x({{
                                Mem_uh = Rs2_uh;
                            }},
                            ea_code = {{ EA = rvZext(Cs1.getAddress()); }},
                            cap_check_code = {{
                                CHERI_CHECK_MEM(Cs1, CS1, EA, 2, CheriAccStore);
                            }},
                            offset_code = {{ offset = 0; }});
                            0x0a: sw_cap_x({{
                                Mem_uw = Rs2_uw;
                            }},
                            ea_code = {{ EA = rvZext(Cs1.getAddress()); }},
                            cap_check_code = {{
                                CHERI_CHECK_MEM(Cs1, CS1,
                                    EA, 4, CheriAccStore);
                            }},
                            offset_code = {{ offset = 0; }});
                            0x0b: sd_cap_x({{
                                Mem_ud = Rs2_ud;
                            }},
                            ea_code = {{ EA = rvZext(Cs1.getAddress()); }},
                            cap_check_code = {{
                                CHERI_CHECK_MEM(Cs1, CS1,
                                    EA, 8, CheriAccStore);
                            }},
                            offset_code = {{ offset = 0; }});
                        }
                        format CapStore {
                            0x04: sc_ddc({{
                                _storeCap = Cs2;
                            }},
                            ea_code = {{ EA = rvZext(Rs1); }},
                            cap_check_code = {{
                                CHERI_CHECK_CAP_STORE(cheriDdc(xc),
                                    CHERIRiscvISA::CHERI_CAPIDX_DDC, EA, Cs2);
                            }},
                            offset_code = {{ offset = 0; }});
                            0x0c: sc_cap({{
                                _storeCap = Cs2;
                            }},
                            ea_code = {{ EA = rvZext(Cs1.getAddress()); }},
                            cap_check_code = {{
                                CHERI_CHECK_CAP_STORE(Cs1, CS1, EA, Cs2);
                            }},
                            offset_code = {{ offset = 0; }});
                            // sc.c.cap: single in-order hart, the
                            // reservation always holds (as sc.c); the result
                            // goes to the rs2 register.
                            0x1c: sc_c_cap({{
                                _storeCap = Cs2;
                            }},
                            ea_code = {{ EA = rvZext(Cs1.getAddress()); }},
                            cap_check_code = {{
                                CHERI_CHECK_CAP_STORE(Cs1, CS1, EA, Cs2);
                            }},
                            offset_code = {{ offset = 0; }},
                            postacc_code = {{ Rs2 = 0; }});
                        }
                        // sc.[bhwd].cap: result (0 = success) goes to rs2.
                        format StoreCond {
                            0x18: sc_b_cap({{
                                Mem_ub = Rs2_ub;
                            }}, {{
                                Rs2_ub = result;
                            }}, inst_flags=IsStoreConditional, mem_flags=LLSC);
                            0x19: sc_h_cap({{
                                Mem_uh = Rs2_uh;
                            }}, {{
                                Rs2_uh = result;
                            }}, inst_flags=IsStoreConditional, mem_flags=LLSC);
                            0x1a: sc_w_cap({{
                                Mem_uw = Rs2_uw;
                            }}, {{
                                Rs2_uw = result;
                            }}, inst_flags=IsStoreConditional, mem_flags=LLSC);
                            0x1b: sc_d_cap({{
                                Mem_ud = Rs2_ud;
                            }}, {{
                                Rs2_ud = result;
                            }}, inst_flags=IsStoreConditional, mem_flags=LLSC);
                        }
                    }

                    // Explicit capability-addressed loads (CheriLoad_r,
                    // funct7 0x7d): the operation is in the rs2 field.
                    0x7d: decode RS2 {
                        format CapDataLoad {
                            0x00: lb_ddc({{
                                Rd_sd = Mem_sb;
                            }},
                            ea_code = {{ EA = rvZext(Rs1); }},
                            cap_check_code = {{
                                CHERI_CHECK_MEM_DDC(EA, 1, CheriAccLoad);
                            }},
                            offset_code = {{ offset = 0; }});
                            0x01: lh_ddc({{
                                Rd_sd = Mem_sh;
                            }},
                            ea_code = {{ EA = rvZext(Rs1); }},
                            cap_check_code = {{
                                CHERI_CHECK_MEM_DDC(EA, 2, CheriAccLoad);
                            }},
                            offset_code = {{ offset = 0; }});
                            0x02: lw_ddc({{
                                Rd_sd = Mem_sw;
                            }},
                            ea_code = {{ EA = rvZext(Rs1); }},
                            cap_check_code = {{
                                CHERI_CHECK_MEM_DDC(EA, 4, CheriAccLoad);
                            }},
                            offset_code = {{ offset = 0; }});
                            0x03: ld_ddc({{
                                Rd_sd = Mem_sd;
                            }},
                            ea_code = {{ EA = rvZext(Rs1); }},
                            cap_check_code = {{
                                CHERI_CHECK_MEM_DDC(EA, 8, CheriAccLoad);
                            }},
                            offset_code = {{ offset = 0; }});
                            0x04: lbu_ddc({{
                                Rd = Mem_ub;
                            }},
                            ea_code = {{ EA = rvZext(Rs1); }},
                            cap_check_code = {{
                                CHERI_CHECK_MEM_DDC(EA, 1, CheriAccLoad);
                            }},
                            offset_code = {{ offset = 0; }});
                            0x05: lhu_ddc({{
                                Rd = Mem_uh;
                            }},
                            ea_code = {{ EA = rvZext(Rs1); }},
                            cap_check_code = {{
                                CHERI_CHECK_MEM_DDC(EA, 2, CheriAccLoad);
                            }},
                            offset_code = {{ offset = 0; }});
                            0x06: lwu_ddc({{
                                Rd = Mem_uw;
                            }},
                            ea_code = {{ EA = rvZext(Rs1); }},
                            cap_check_code = {{
                                CHERI_CHECK_MEM_DDC(EA, 4, CheriAccLoad);
                            }},
                            offset_code = {{ offset = 0; }});
                            0x08: lb_cap_x({{
                                Rd_sd = Mem_sb;
                            }},
                            ea_code = {{ EA = rvZext(Cs1.getAddress()); }},
                            cap_check_code = {{
                                CHERI_CHECK_MEM(Cs1, CS1, EA, 1, CheriAccLoad);
                            }},
                            offset_code = {{ offset = 0; }});
                            0x09: lh_cap_x({{
                                Rd_sd = Mem_sh;
                            }},
                            ea_code = {{ EA = rvZext(Cs1.getAddress()); }},
                            cap_check_code = {{
                                CHERI_CHECK_MEM(Cs1, CS1, EA, 2, CheriAccLoad);
                            }},
                            offset_code = {{ offset = 0; }});
                            0x0a: lw_cap_x({{
                                Rd_sd = Mem_sw;
                            }},
                            ea_code = {{ EA = rvZext(Cs1.getAddress()); }},
                            cap_check_code = {{
                                CHERI_CHECK_MEM(Cs1, CS1, EA, 4, CheriAccLoad);
                            }},
                            offset_code = {{ offset = 0; }});
                            0x0b: ld_cap_x({{
                                Rd_sd = Mem_sd;
                            }},
                            ea_code = {{ EA = rvZext(Cs1.getAddress()); }},
                            cap_check_code = {{
                                CHERI_CHECK_MEM(Cs1, CS1, EA, 8, CheriAccLoad);
                            }},
                            offset_code = {{ offset = 0; }});
                            0x0c: lbu_cap_x({{
                                Rd = Mem_ub;
                            }},
                            ea_code = {{ EA = rvZext(Cs1.getAddress()); }},
                            cap_check_code = {{
                                CHERI_CHECK_MEM(Cs1, CS1, EA, 1, CheriAccLoad);
                            }},
                            offset_code = {{ offset = 0; }});
                            0x0d: lhu_cap_x({{
                                Rd = Mem_uh;
                            }},
                            ea_code = {{ EA = rvZext(Cs1.getAddress()); }},
                            cap_check_code = {{
                                CHERI_CHECK_MEM(Cs1, CS1, EA, 2, CheriAccLoad);
                            }},
                            offset_code = {{ offset = 0; }});
                            0x0e: lwu_cap_x({{
                                Rd = Mem_uw;
                            }},
                            ea_code = {{ EA = rvZext(Cs1.getAddress()); }},
                            cap_check_code = {{
                                CHERI_CHECK_MEM(Cs1, CS1, EA, 4, CheriAccLoad);
                            }},
                            offset_code = {{ offset = 0; }});
                        }
                        format LoadReserved {
                            0x18: lr_b_cap({{
                                Rd_sd = Mem_sb;
                            }}, mem_flags=LLSC);
                            0x19: lr_h_cap({{
                                Rd_sd = Mem_sh;
                            }}, mem_flags=LLSC);
                            0x1a: lr_w_cap({{
                                Rd_sd = Mem_sw;
                            }}, mem_flags=LLSC);
                            0x1b: lr_d_cap({{
                                Rd_sd = Mem_sd;
                            }}, mem_flags=LLSC);
                        }
                        format CapLoad {
                            0x17: lc_ddc({{
                                Cd = capLoadResult(_loadedCap, cheriDdc(xc));
                            }},
                            ea_code = {{ EA = rvZext(Rs1); }},
                            cap_check_code = {{
                                CHERI_CHECK_MEM_DDC(EA, 16,
                                    CheriAccLoad | CheriAccCap);
                            }},
                            offset_code = {{ offset = 0; }});
                            0x1c: lr_c_cap({{
                                Cd = capLoadResult(_loadedCap, CHERI_MEM_AUTH(Cs1));
                            }},
                            ea_code = {{ EA = rvZext(Cs1.getAddress()); }},
                            cap_check_code = {{
                                CHERI_CHECK_MEM(Cs1, CS1, EA, 16,
                                    CheriAccLoad | CheriAccCap);
                            }},
                            offset_code = {{ offset = 0; }});
                            0x1f: lc_cap({{
                                Cd = capLoadResult(_loadedCap, CHERI_MEM_AUTH(Cs1));
                            }},
                            ea_code = {{ EA = rvZext(Cs1.getAddress()); }},
                            cap_check_code = {{
                                CHERI_CHECK_MEM(Cs1, CS1, EA, 16,
                                    CheriAccLoad | CheriAccCap);
                            }},
                            offset_code = {{ offset = 0; }});
                        }
                    }
                }

                format COp {
                    0x1: cincoffsetimm({{
                        // CIncOffsetImm cd, cs1, simm12 (tag cleared if sealed
                        // or the new address
                        // is not representable).
                        int64_t imm = sext<12>(IMM12);
                        Cd = cheriResult(xc, capSetAddr(Cs1, Cs1.getAddress()
                            + imm), Cs1.getTag());
                    }});
                }

                format COp {
                    0x2: csetboundsimm({{
                        // CSetBoundsImm cd, cs1, uimm12.
                        uint64_t imm = IMM12 & 0xFFF;
                        Cd = cheriResult(xc, capSetBounds(Cs1, imm, false),
                            Cs1.getTag());
                    }});
                }
            }

        0x18: decode FUNCT3 {
            format BOp {
                0x0: beq({{
                    if (rvSext(Rs1) == rvSext(Rs2)) {
                        if (Fault _f = cheriCheckBranch(xc, rvZext(PC + imm)))
                            return _f;
                        NPC = rvZext(PC + imm);
                    } else {
                        NPC = rvZext(NPC);
                    }
                }}, IsDirectControl, IsCondControl);
                0x1: bne({{
                    if (rvSext(Rs1) != rvSext(Rs2)) {
                        if (Fault _f = cheriCheckBranch(xc, rvZext(PC + imm)))
                            return _f;
                        NPC = rvZext(PC + imm);
                    } else {
                        NPC = rvZext(NPC);
                    }
                }}, IsDirectControl, IsCondControl);
                0x4: blt({{
                    if (rvSext(Rs1_sd) < rvSext(Rs2_sd)) {
                        if (Fault _f = cheriCheckBranch(xc, rvZext(PC + imm)))
                            return _f;
                        NPC = rvZext(PC + imm);
                    } else {
                        NPC = rvZext(NPC);
                    }
                }}, IsDirectControl, IsCondControl);
                0x5: bge({{
                    if (rvSext(Rs1_sd) >= rvSext(Rs2_sd)) {
                        if (Fault _f = cheriCheckBranch(xc, rvZext(PC + imm)))
                            return _f;
                        NPC = rvZext(PC + imm);
                    } else {
                        NPC = rvZext(NPC);
                    }
                }}, IsDirectControl, IsCondControl);
                0x6: bltu({{
                    if (rvZext(Rs1) < rvZext(Rs2)) {
                        if (Fault _f = cheriCheckBranch(xc, rvZext(PC + imm)))
                            return _f;
                        NPC = rvZext(PC + imm);
                    } else {
                        NPC = rvZext(NPC);
                    }
                }}, IsDirectControl, IsCondControl);
                0x7: bgeu({{
                    if (rvZext(Rs1) >= rvZext(Rs2)) {
                        if (Fault _f = cheriCheckBranch(xc, rvZext(PC + imm)))
                            return _f;
                        NPC = rvZext(PC + imm);
                    } else {
                        NPC = rvZext(NPC);
                    }
                }}, IsDirectControl, IsCondControl);
            }
        }

        0x19: decode FUNCT3 {
            0x0: decode CAPMODE {
                0x0: Jump::jalr({{
                    // Integer jump within the current PCC (Sail
                    // ext_control_check_addr), integer link.
                    Addr _target = rvZext((imm + Rs1) & (~0x1));
                    if (Fault _f = cheriCheckBranch(xc, _target))
                        return _f;
                    Rd = rvSext(NPC);
                    NPC = _target;
                }}, IsIndirectControl, IsUncondControl);
                0x1: Jump::cjalr({{
                // CJALR (purecap jalr): jump to cs1 + imm, link a sentry
                // for the next instruction into cd. Cs1 is read before Cd is
                // written (common case: jalr cra, 0(cra)).
                CapRegContainer _link;
                if (Fault _f = cheriIndirectJump(xc, Cs1, CS1, imm,
                        xc->pcState().as<PCState>().npc(), &_link))
                    return _f;
                Cd = _link;
            }}, IsControl, IsIndirectControl, IsUncondControl);
            }
        }

        // CJAL (purecap jal): the link register receives the PCC with its
        // address set to the return address, sealed as a sentry. (Writing the
        // integer return address instead produced untagged return
        // capabilities that the following cret could not legally use.)
        0x1b: decode CAPMODE {
            0x0: JOp::jal({{
                if (Fault _f = cheriCheckBranch(xc, rvZext(PC + imm)))
                    return _f;
                Rd = rvSext(NPC);
                NPC = rvZext(PC + imm);
            }}, IsDirectControl, IsUncondControl);
            0x1: JOp::cjal({{
            if (Fault _f = cheriCheckBranch(xc, rvZext(PC + imm)))
                return _f;
            Cd = CHERIRiscvISA::capMakeSentryLink(
                xc->pcState().as<PCState>().pcc(), NPC);
            NPC = rvZext(PC + imm);
        }}, IsDirectControl, IsUncondControl);
        }

        0x1c: decode FUNCT3 {
            format SystemOp {
                0x0: decode FUNCT7 {
                    0x0: decode RS2 {
                        0x0: ecall({{
                            using namespace gem5::CHERIRiscvISA;
                            CHERIPrivilegeMode prv = (CHERIPrivilegeMode)xc
                                    ->readMiscReg(MISCREG_PRV);
                            if (prv == PRV_U) {
                                // User-mode ecall -> real syscall: trap into
                                // the kernel's handler as usual.
                                return std::make_shared<SyscallFault>(prv);
                            }
                            // Supervisor/Machine ecall -> SBI call. We have no
                            // M-mode firmware (OpenSBI), so emulate the SBI in
                            // gem5 and resume at the next instruction (ecall is
                            // not IsControl, so the PC auto-advances on NoFault).
                            handleSbiEcall(xc->tcBase());
                            return NoFault;
                        }}, IsSerializeAfter, IsNonSpeculative, IsSyscall,
                            No_OpClass);
                        0x1: ebreak({{
                            return executeEBreakOrSemihosting(xc);
                        }}, IsSerializeAfter, IsNonSpeculative, No_OpClass);
                        0x2: uret({{
                           MISA misa = xc->readMiscReg(MISCREG_ISA);
                            if (!misa.rvn) {
                                return std::make_shared<IllegalInstFault>(
                                    "sret can't execute without N systems",
                                    machInst);
                            }
                            if (Fault _f = cheriCheckPccAsr(xc))
                                return _f;
                            STATUS status = xc->readMiscReg(MISCREG_STATUS);
                            status.uie = status.upie;
                            status.upie = 1;
                            xc->setMiscReg(MISCREG_STATUS, status);
                            // CHERI: continue at UEPCC (unsealed if a
                            // sentry).
                            auto *isa = dynamic_cast<ISA*>(
                                xc->tcBase()->getIsaPtr());
                            cheriReturnTo(xc,
                                isa->readCapMiscReg(MISCREG_UEPCC));
                        }}, IsSerializeAfter, IsNonSpeculative, IsReturn);
                    }
                    0x8: decode RS2 {
                        0x2: sret({{
                                MISA misa = xc->readMiscReg(MISCREG_ISA);
                                if (!misa.rvs) {
                                    return std::make_shared<IllegalInstFault>(
                                                "sret can't execute without RVS",
                                                machInst);
                                }
                                STATUS status = xc->readMiscReg(MISCREG_STATUS);
                                auto pm = (CHERIPrivilegeMode)xc->readMiscReg(MISCREG_PRV);
                                if (pm == PRV_U ||
                                    (pm == PRV_S && status.tsr == 1)) {
                                    return std::make_shared<IllegalInstFault>(
                                                "sret in user mode or TSR enabled",
                                                machInst);
                                }

                                using namespace gem5::CHERIRiscvISA;
                                if (Fault _f = cheriCheckPccAsr(xc))
                                    return _f;

                                xc->setMiscReg(MISCREG_PRV, status.spp);
                                status.sie = status.spie;
                                status.spie = 1;
                                status.spp = PRV_U;
                                xc->setMiscReg(MISCREG_STATUS, status);

                                // ── CHERI: continue at SEPCC (unsealed if a
                                // sentry) ──
                                auto *isa = dynamic_cast<ISA*>(
                                    xc->tcBase()->getIsaPtr());
                                cheriReturnTo(xc,
                                    isa->readCapMiscReg(MISCREG_SEPCC));
                        }}, IsSerializeAfter, IsNonSpeculative, IsReturn);
                        0x5: wfi({{
                            MISA misa = xc->readMiscReg(MISCREG_ISA);
                            STATUS status = xc->readMiscReg(MISCREG_STATUS);
                            auto pm = (CHERIPrivilegeMode)xc->readMiscReg(
                                MISCREG_PRV);
                            if (misa.rvs && (pm == PRV_U ||
                                (pm == PRV_S && status.tw == 1))) {
                                return std::make_shared<IllegalInstFault>(
                                            "wfi in user mode or TW enabled",
                                            machInst);
                            }
                            // Go to sleep only if there's no pending interrupt
                            // at all, including masked interrupts.
                            auto tc = xc->tcBase();
                            auto cpu = tc->getCpuPtr();
                            auto ic = dynamic_cast<CHERIRiscvISA::Interrupts*>(
                                cpu->getInterruptController(tc->threadId()));
                            panic_if(!ic, "Invalid Interrupt Controller.");
                            if (ic->readIP() == 0
                                && xc->readMiscReg(MISCREG_NMIP) == 0) {
                                tc->quiesce();
                            }
                        }}, IsNonSpeculative, IsQuiesce,
                            IsSerializeAfter, No_OpClass, IsSquashAfter);
                    }
                    0x9: sfence_vma({{
                        MISA misa = xc->readMiscReg(MISCREG_ISA);
                        if (!misa.rvs) {
                            return std::make_shared<IllegalInstFault>(
                                "sfence_vma can't execute without RVS",
                                machInst);
                        }
                        STATUS status = xc->readMiscReg(MISCREG_STATUS);
                        auto pm = (CHERIPrivilegeMode)xc->
                                readMiscReg(MISCREG_PRV);
                        if (pm == PRV_U || (pm == PRV_S && status.tvm == 1)) {
                            return std::make_shared<IllegalInstFault>(
                                        "sfence in user mode or TVM enabled",
                                        machInst);
                        }
                        xc->tcBase()->getMMUPtr()->demapPage(Rs1, Rs2);
                    }}, IsNonSpeculative, IsSerializeAfter, No_OpClass);
                    0x18: mret({{
                        if (xc->readMiscReg(MISCREG_PRV) != PRV_M) {
                            return std::make_shared<IllegalInstFault>(
                                        "mret at lower privilege", machInst);
                        }

                        using namespace gem5::CHERIRiscvISA;
                        if (Fault _f = cheriCheckPccAsr(xc))
                            return _f;

                        // Restore privilege state
                        STATUS status = xc->readMiscReg(MISCREG_STATUS);
                        xc->setMiscReg(MISCREG_PRV, status.mpp);
                        xc->setMiscReg(MISCREG_NMIE, 1);
                        status.mie = status.mpie;
                        status.mpie = 1;
                        status.mpp = PRV_U;
                        xc->setMiscReg(MISCREG_STATUS, status);

                        // ── CHERI: continue at MEPCC (unsealed if a sentry)
                        // ──
                        auto *isa = dynamic_cast<ISA*>(
                            xc->tcBase()->getIsaPtr());
                        cheriReturnTo(xc, isa->readCapMiscReg(MISCREG_MEPCC));
                    }}, IsSerializeAfter, IsNonSpeculative, IsReturn);
                }
            }
            format CSROp {
                0x1: csrrw({{
                    Rd = rvSext(data);
                    data = rvZext(Rs1);
                }}, 'RD != 0', 'true'
                  , IsSerializeAfter, IsNonSpeculative, No_OpClass);
                0x2: csrrs({{
                    Rd = rvSext(data);
                    data = rvZext(data | Rs1);
                }}, 'true', 'RS1 != 0'
                  , IsSerializeAfter, IsNonSpeculative, No_OpClass);
                0x3: csrrc({{
                    Rd = rvSext(data);
                    data = rvZext(data & ~Rs1);
                }}, 'true', 'RS1 != 0'
                  , IsSerializeAfter, IsNonSpeculative, No_OpClass);
                0x5: csrrwi({{
                    Rd = rvSext(data);
                    data = rvZext(uimm);
                }}, 'RD != 0', 'true'
                  , IsSerializeAfter, IsNonSpeculative, No_OpClass);
                0x6: csrrsi({{
                    Rd = rvSext(data);
                    data = rvZext(data | uimm);
                }}, 'true', 'uimm != 0'
                  , IsSerializeAfter, IsNonSpeculative, No_OpClass);
                0x7: csrrci({{
                    Rd = rvSext(data);
                    data = rvZext(data & ~uimm);
                }}, 'true', 'uimm != 0'
                  , IsSerializeAfter, IsNonSpeculative, No_OpClass);
            }
        }

        0x1e: M5Op::M5Op();
    }
}
