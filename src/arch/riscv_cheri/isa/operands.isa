    'sb' : 'int8_t',
    'ub' : 'uint8_t',
    'sh' : 'int16_t',
    'uh' : 'uint16_t',
    'sw' : 'int32_t',
    'uw' : 'uint32_t',
    'sd' : 'int64_t',
    'ud' : 'uint64_t',
    'sf' : 'float',
    'df' : 'double',

    'vi'    : 'vi',
    'vu'    : 'vu',
    'vwi'   : 'vwi',
    'vwu'   : 'vwu',
    'vext'  : 'vext',
    'vextu' : 'vextu',
    'vc'    : 'CHERIRiscvISA::VecRegContainer', 
    'capc'  : 'CHERIRiscvISA::CapRegContainer'
}};

// =====================================================================
// MERGED REGISTER FILE (CHERI) -- added to boot the CheriBSD purecap kernel.
//
// WHY:
//   CheriBSD is compiled for a *merged* register file: integer register
//   x_n and capability register c_n are the SAME architectural register.
//   Reading x_n yields c_n's address; writing x_n yields a null-derived
//   (untagged) capability whose address is the written value.
//
//   Previously integer operands used a SEPARATE intRegClass storage, so a
//   value produced by a capability instruction (e.g. `auipcc ct0`) was not
//   visible to a following integer instruction (`addi t0, t0, imm`), and
//   vice-versa. That broke the locore "enter capability mode" trampoline
//   (auipcc ct0,0 ; addi t0,t0,26 ; csetaddr ct1,ct1,t0 ; jalr.cap ct1),
//   which then jumped to itself and hung the boot in an infinite loop.
//
// WHAT THIS DOES:
//   Every integer operand now reads/writes the CAPABILITY register file
//   (capRegClass), using the capability's address field as the integer
//   view. capRegClass and intRegClass share the same 1:1 index numbering
//   (x_n <-> c_n, x0 <-> cnull, Ureg0 <-> CUreg0), so every reg_spec
//   expression (RD, RS1, AMOTempReg, ReturnAddrReg, ...) is reused as-is.
//   The intRegClass storage in regs/int.hh becomes unused (dead), but is
//   left in place so this change is trivially revertible.
//
// HOW TO REVERT:
//   Delete the merged `IntReg` class below and un-comment the ORIGINAL
//   `IntReg` class (kept commented directly under it). No other file needs
//   to change -- intRegClass is still declared in regs/int.hh.
//
// NOTE:
//   The per-instruction `xc->tcBase()->setReg(intRegClass[CD], ...)` sync
//   lines added earlier in decoder.isa are now REDUNDANT (nothing reads
//   intRegClass anymore). They are harmless dead writes and can be removed
//   later; left in place for now to keep this change isolated.
// =====================================================================
let {{
    class IntReg(IntRegOp):
        # Integer operand N aliases capability register N (merged file).
        # Always target a real capRegClass register -- even index 0 (cnull) --
        # so the container get/setRegOperand forms have a valid RegId. The
        # zero register (x0/cnull) is handled explicitly in makeRead/makeWrite.
        @overrideInOperand
        def regId(self):
            return f'capRegClass[{self.reg_spec}]'

        # READ: expose the capability's 64-bit address as this operand's
        # integer value. Reading x0 reads cnull, whose address is 0.
        @overrideInOperand
        def makeRead(self):
            tmp = f'tmp_s{self.src_reg_idx}'
            return (
                f'{self.parser.namespace}::CapRegContainer {tmp};\n'
                f'xc->getRegOperand(this, {self.src_reg_idx}, &{tmp});\n'
                f'{self.base_name} = {tmp}.getAddress();\n'
            )

        # WRITE: an integer result is a null-derived (untagged) capability
        # whose address is the value. Writes to x0/cnull are discarded to
        # preserve RISC-V zero-register semantics (the container form of
        # setRegOperand does NOT filter InvalidRegClass, so we guard here).
        #
        # IMPORTANT lexer constraint: the isa-parser ends a let CODELIT block at
        # the FIRST double-close-brace it sees (regex in isa_parser.py
        # t_CODELIT). So the Python source in this block must NEVER contain a
        # doubled open- or close-brace -- not even inside a comment. We build the
        # generated C++ braces from single-char `ob`/`cb` variables below instead
        # of using f-string doubled-brace escapes.
        @overrideInOperand
        def makeWrite(self):
            ob = '{'
            cb = '}'
            tmp = f'tmp_d{self.dest_reg_idx}'
            ns = self.parser.namespace
            return (
                f'\n{ob}\n'
                f'    if (({self.reg_spec}) != 0) {ob}\n'
                f'        {ns}::CapRegContainer {tmp};\n'
                f'        {tmp}.setAddress((uint64_t)({self.base_name}));\n'
                f'        {tmp}.setTag(false);\n'
                f'        xc->setRegOperand(this, {self.dest_reg_idx}, &{tmp});\n'
                f'        if (traceData) {ob}\n'
                f'            traceData->setData(capRegClass, &{tmp});\n'
                f'        {cb}\n'
                f'    {cb}\n'
                f'{cb}\n'
            )
}};

// ---- ORIGINAL split-register-file IntReg (kept for revert) ----------
// let {{
//     class IntReg(IntRegOp):
//         @overrideInOperand
//         def regId(self):
//             return f'(({self.reg_spec}) == 0) ? RegId() : ' \
//                    f'{self.reg_class}[{self.reg_spec}]'
// }};
// ---------------------------------------------------------------------

let {{
    class CapReg(CapRegOp):
        @overrideInOperand
        def regId(self):
            return f'{self.reg_class}[{self.reg_spec}]'
}};

def operands {{
#General Purpose Integer Reg Operands
    'Rd': IntReg('ud', 'RD', 'IsInteger', 1),
    'Rs1': IntReg('ud', 'RS1', 'IsInteger', 2),
    'Rs2': IntReg('ud', 'RS2', 'IsInteger', 3),
    'Rt': IntReg('ud', 'AMOTempReg', 'IsInteger', 4),
    'Rc1': IntReg('ud', 'RC1', 'IsInteger', 2),
    'Rc2': IntReg('ud', 'RC2', 'IsInteger', 3),
    'Rp1': IntReg('ud', 'RP1 + 8', 'IsInteger', 2),
    'Rp2': IntReg('ud', 'RP2 + 8', 'IsInteger', 3),
    'ra': IntReg('ud', 'ReturnAddrReg', 'IsInteger', 1),
    'sp': IntReg('ud', 'StackPointerReg', 'IsInteger', 2),

    'a0': IntReg('ud', '10', 'IsInteger', 1),
    'a1': IntReg('ud', '11', 'IsInteger', 2),

    'Fd': FloatRegOp('df', 'FD', 'IsFloating', 1),
    'Fd_bits': FloatRegOp('ud', 'FD', 'IsFloating', 1),
    'Fs1': FloatRegOp('df', 'FS1', 'IsFloating', 2),
    'Fs1_bits': FloatRegOp('ud', 'FS1', 'IsFloating', 2),
    'Fs2': FloatRegOp('df', 'FS2', 'IsFloating', 3),
    'Fs2_bits': FloatRegOp('ud', 'FS2', 'IsFloating', 3),
    'Fs3': FloatRegOp('df', 'FS3', 'IsFloating', 4),
    'Fs3_bits': FloatRegOp('ud', 'FS3', 'IsFloating', 4),
    'Fc1': FloatRegOp('df', 'FC1', 'IsFloating', 1),
    'Fc1_bits': FloatRegOp('ud', 'FC1', 'IsFloating', 1),
    'Fc2': FloatRegOp('df', 'FC2', 'IsFloatReg', 2),
    'Fc2_bits': FloatRegOp('ud', 'FC2', 'IsFloating', 2),
    'Fp2': FloatRegOp('df', 'FP2 + 8', 'IsFloating', 2),
    'Fp2_bits': FloatRegOp('ud', 'FP2 + 8', 'IsFloating', 2),

    'Vd':  VecRegOp('vc', 'VD', 'IsVector', 1),
    'Vs1': VecRegOp('vc', 'VS1', 'IsVector', 2),
    'Vs2': VecRegOp('vc', 'VS2', 'IsVector', 3),
    'Vs3': VecRegOp('vc', 'VS3', 'IsVector', 4),

#Capability Operands
    'Cd': CapReg('capc', 'CD', 'IsCapability', 1),
#   'CdMeta': CapReg('capc', 'CD + 32', 'IsCapability', 1),
    'Cs1': CapReg('capc', 'CS1', 'IsCapability', 2),
    'Cs2': CapReg('capc', 'CS2', 'IsCapability', 3),
    'Cs1Meta': CapReg('capc', 'CS1 + 32', 'IsCapability', 2),
    'Cs2Meta': CapReg('capc', 'CS2 + 32', 'IsCapability', 3),
    'Ct': CapReg('capc', 'AMOTempCap', 'IsCapability', 4),
    'Cc1': CapReg('capc', 'CC1', 'IsCapability', 2),
    'Cc2': CapReg('capc', 'CC2', 'IsCapability', 3),
    'Cp1': CapReg('capc', 'CP1 + 8', 'IsCapability', 2),
    'Cp2': CapReg('capc', 'CP2 + 8', 'IsCapability', 3),
    'Cra': CapReg('capc', 'ReturnAddrCap', 'IsCapability', 1),
    'Csp': CapReg('capc', 'StackPointerCap', 'IsCapability', 2),

    'Ca0': CapReg('capc', '10', 'IsCapability', 1),
    'Ca1': CapReg('capc', '11', 'IsCapability', 2),

#Memory Operand
    'Mem': MemOp('ud', None, (None, 'IsLoad', 'IsStore'), 5),

#Program Counter Operands
    'PC': PCStateOp('ud', 'pc', (None, None, 'IsControl'), 7),
    'NPC': PCStateOp('ud', 'npc', (None, None, 'IsControl'), 8),

# VL and VTYPE
    'Vtype': PCStateOp('ud', 'vtype', (None, None, 'IsControl'), 10),
    'VL': PCStateOp('uw', 'vl', (None, None, 'IsControl'), 11),
#VLENB, actually the CSR is read only.
    'VlenbBits': PCStateOp('ud', 'vlenb', (None, None, 'IsControl'), 12),
}};
