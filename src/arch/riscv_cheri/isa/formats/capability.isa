////////////////////////////////////////////////////////////////////
//
// Capability instructions
//

def template CapImmDeclare {{
    //
    // Static instruction class for "%(mnemonic)s".
    //
    class %(class_name)s : public %(base_class)s
    {
      private:
        %(reg_idx_arr_decl)s;

      public:
        /// Constructor.
        %(class_name)s(ExtMachInst machInst);
        Fault execute(ExecContext *, trace::InstRecord *) const override;
        std::string generateDisassembly(Addr pc,
            const loader::SymbolTable *symtab) const override;
    };
}};

def template CapImmConstructor {{
    %(class_name)s::%(class_name)s(ExtMachInst machInst)
        : %(base_class)s("%(mnemonic)s", machInst, %(op_class)s)
    {
        %(set_reg_idx_arr)s;
        %(constructor)s;
        %(imm_code)s;
    }
}};

def template CapImmExecute {{
    Fault
    %(class_name)s::execute(
        ExecContext *xc, trace::InstRecord *traceData) const
    {
        %(op_decl)s;
        %(op_rd)s;
        %(code)s;
        %(op_wb)s;
        return NoFault;
    }

    std::string
    %(class_name)s::generateDisassembly(Addr pc,
            const loader::SymbolTable *symtab) const
    {
        std::vector<RegId> indices = {%(regs)s};
        std::stringstream ss;
        ss << mnemonic << ' ';
        for (const RegId& idx: indices)
            ss << registerName(idx) << ", ";
        ss << imm;
        return ss.str();
    }
}};



def format CapIOp(code, imm_type='int64_t', imm_code='imm = sext<12>(IMM12);',
              *opt_flags) {{
    regs = ['destRegIdx(0)','srcRegIdx(0)']
    iop = InstObjParams(name, Name, 'ImmOp<%s>' % imm_type,
        {'imm_code': imm_code, 'code': code,
         'regs': ','.join(regs)}, opt_flags)
    header_output = CapImmDeclare.subst(iop)
    decoder_output = CapImmConstructor.subst(iop)
    decode_block = BasicDecode.subst(iop)
    exec_output = CapImmExecute.subst(iop)
}};

def format COp(code, *opt_flags) {{
    iop = InstObjParams(name, Name, 'CapOp', code, opt_flags)
    header_output = BasicDeclare.subst(iop)
    decoder_output = BasicConstructor.subst(iop)
    decode_block = BasicDecode.subst(iop)
    exec_output = BasicExecute.subst(iop)
}};

////////////////////////////////////////////////////////////////////
//
// CHERI tag-table load (cloadtags): reads the 8 tags of a 128-byte
// region through the LSQ (initiateAcc/completeAcc).
//

def template CTagLoadDeclare {{
    class %(class_name)s : public %(base_class)s
    {
      private:
        %(reg_idx_arr_decl)s;

      public:
        %(class_name)s(ExtMachInst machInst);

        Fault execute(ExecContext *, trace::InstRecord *) const override;
        Fault initiateAcc(ExecContext *, trace::InstRecord *) const override;
        Fault completeAcc(PacketPtr, ExecContext *,
                          trace::InstRecord *) const override;
    };
}};

def template CTagLoadConstructor {{
    %(class_name)s::%(class_name)s(ExtMachInst machInst):
        %(base_class)s("%(mnemonic)s", machInst, %(op_class)s)
    {
        %(set_reg_idx_arr)s;
        %(constructor)s;
    }
}};

def template CTagLoadExecute {{
    // Functional path (atomic CPU and functional accesses)
    Fault
    %(class_name)s::execute(
        ExecContext *xc, trace::InstRecord *traceData) const
    {
        Addr EA;

        %(op_decl)s;
        %(op_rd)s;
        %(ea_code)s;

        // Capability permission and bounds check
        %(cap_check_code)s;

        %(code)s;
        %(op_wb)s;
        return NoFault;
    }
}};

def template CTagLoadInitiateAcc {{
    Fault
    %(class_name)s::initiateAcc(ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        Addr EA;

        %(op_src_decl)s;
        %(op_rd)s;
        %(ea_code)s;

        // Capability permission and bounds check
        %(cap_check_code)s;

        // One 128-byte tag-table read through the LSQ, served locally
        // (CHERI_TAG_LOAD); CHERI_CAP_LOAD applies the PTE checks.
        const std::vector<bool> byte_enable(128, true);
        return xc->initiateMemRead(EA, 128,
            Request::CHERI_CAP_LOAD | Request::CHERI_TAG_LOAD,
            byte_enable);
    }
}};

def template CTagLoadCompleteAcc {{
    Fault
    %(class_name)s::completeAcc(PacketPtr pkt, ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        %(op_decl)s;

        // Read the 8 tags from the tag table by physical address; the
        // packet carries no data.
        uint64_t tag_bits = 0;
        bool clear_tags = pkt->req->getClearTagOnLoad();
        System *csys = xc->tcBase()->getSystemPtr();
        for (uint64_t i = 0; !clear_tags && i < 8; i++) {
            if (csys->cheritagtable.getTag(pkt->getAddr() + i * 16))
                tag_bits |= (1ULL << i);
        }
        Rd = tag_bits;

        %(op_wb)s;

        return NoFault;
    }
}};

let {{
def CTagLoadBase(name, Name, ea_code, cap_check_code, code, inst_flags,
        base_class='CapOp'):

    iop = InstObjParams(name, Name, base_class,
        {'ea_code': ea_code,
         'cap_check_code': cap_check_code,
         'code': code},
        inst_flags)

    return (CTagLoadDeclare.subst(iop),
        CTagLoadConstructor.subst(iop),
        BasicDecode.subst(iop),
        CTagLoadExecute.subst(iop) +
        CTagLoadInitiateAcc.subst(iop) +
        CTagLoadCompleteAcc.subst(iop))
}};

def format CTagLoad(code, ea_code, cap_check_code, *opt_flags) {{
    (header_output, decoder_output, decode_block, exec_output) = \
        CTagLoadBase(name, Name, ea_code, cap_check_code, code, opt_flags)
}};
