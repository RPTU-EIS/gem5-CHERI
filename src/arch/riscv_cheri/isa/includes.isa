#include "sim/full_system.hh"
#include "sim/pseudo_inst.hh"
#include "sim/sim_events.hh"

// Needed by CapLoadCompleteAcc: read the CHERI tag CPU-side from the tag
// table (system->cheritagtable) by physical address.
#include "sim/system.hh"

// Needed by ecall: emulate SBI calls in gem5 (no OpenSBI firmware).
#include "arch/riscv_cheri/cheri_checks.hh"
#include "arch/riscv_cheri/sbi.hh"
#include "sim/sim_exit.hh"
#include "sim/system.hh"

// CHERI memory-access check for an instruction body (ea_code): raise the
// capability exception, if any, for an access of `size` bytes at `ea`
// authorised by `auth`, the value of capability register `idx` (reported in
// xTVAL). Pass operand values (Cs1, or _capv_Rs1 for an integer base
// operand), never registers re-read through the thread context. `acc` is a
// CheriAccess mask.
#define CHERI_CHECK_MEM(auth, idx, ea, size, acc)                         \
    do {                                                                  \
        if (Fault _cheri_fault = CHERIRiscvISA::cheriCheckMem(            \
                xc->tcBase(), CHERI_MEM_AUTH(auth),                       \
                CHERI_MEM_AUTH_IDX(idx), (ea), (size), (acc)))            \
            return _cheri_fault;                                          \
    } while (0)

// Capability store of `val` (CheriAccStore|CheriAccCap plus STORE_CAP /
// STORE_LOCAL_CAP checks on the stored value).
#define CHERI_CHECK_CAP_STORE(auth, idx, ea, val)                         \
    do {                                                                  \
        const CapRegContainer _cheri_val = (val);                        \
        if (Fault _cheri_fault = CHERIRiscvISA::cheriCheckMem(            \
                xc->tcBase(), CHERI_MEM_AUTH(auth),                       \
                CHERI_MEM_AUTH_IDX(idx), (ea), 16,                        \
                CHERIRiscvISA::CheriAccStore |                            \
                CHERIRiscvISA::CheriAccCap, &_cheri_val))                 \
            return _cheri_fault;                                          \
    } while (0)

// Which capability authorises a memory access (Sail
// get_cheri_mode_cap_addr). The standard RISC-V encodings are mode
// dependent: the base register's capability in capability mode, DDC in
// integer (hybrid) mode, at the same address. The explicit forms in the
// CHERI major opcode (0x5b: lb.cap, lc.cap, lr.w.cap, ...) always name
// their capability, so the mode does not matter for them. `auth`/`idx`
// are what capability mode would use.
#define CHERI_MEM_USES_DDC (!CAPMODE && bits(machInst, 6, 0) != 0x5b)
#define CHERI_MEM_AUTH(auth)                                              \
    (CHERI_MEM_USES_DDC ? cheriDdc(xc) : CapRegContainer(auth))
#define CHERI_MEM_AUTH_IDX(idx)                                           \
    (CHERI_MEM_USES_DDC ? CHERIRiscvISA::CHERI_CAPIDX_DDC : (int)(idx))

// Explicit DDC-relative accesses (lb.ddc, lc.ddc, sb.ddc, ...).
#define CHERI_CHECK_MEM_DDC(ea, size, acc)                                \
    do {                                                                  \
        if (Fault _cheri_fault = CHERIRiscvISA::cheriCheckMem(            \
                xc->tcBase(), cheriDdc(xc),                               \
                CHERIRiscvISA::CHERI_CAPIDX_DDC, (ea), (size), (acc)))    \
            return _cheri_fault;                                          \
    } while (0)

namespace gem5::CHERIRiscvISAInst
{
using namespace CHERIRiscvISA;

// Result of a capability manipulation that ISAv9 makes tag-clearing (bounds,
// permission, address and flag changes): where violations are enforced the
// architectural result `r` is used as is; elsewhere (the kernel during
// bring-up, see cheriEnforcing()) the source tag is kept, as before.
inline CapRegContainer
cheriResult(ExecContext *xc, CapRegContainer r, bool src_tag)
{
    if (!cheriEnforcing(xc->tcBase()))
        r.setTag(src_tag);
    return r;
}

// Default data capability (cs1 == 0 in CBuildCap/CTestSubset/CFromPtr/...).
inline CapRegContainer
cheriDdc(ExecContext *xc)
{
    auto *isa = static_cast<CHERIRiscvISA::ISA *>(xc->tcBase()->getIsaPtr());
    return isa->readCapMiscReg(MISCREG_DDC);
}

// xRET: continue at xEPCC (a sentry is unsealed). The PC state is written
// directly; assigning the NPC operand instead would write back a PC state
// snapshot taken before the body ran, i.e. with the OLD (kernel) PCC.
inline void
cheriReturnTo(ExecContext *xc, CapRegContainer epcc)
{
    MISA misa = xc->readMiscReg(MISCREG_ISA);
    epcc = capLegalizeEpcc(epcc, misa.rvc);
    Addr target = epcc.getAddress();
    PCState next = xc->pcState().as<PCState>();
    next.pcc(capJumpTargetPcc(epcc, target));
    next.set(target);
    next.npc(target);
    xc->pcState(next);
}

// Direct jump or taken branch to `target` (JAL, Bxx, C.J, C.BEQZ, ...): the
// target must lie within PCC. Checked at the branch, before the link
// register is written (Sail ext_control_check_pc).
inline Fault
cheriCheckBranch(ExecContext *xc, Addr target)
{
    const PCState &cur = xc->pcState().as<PCState>();
    CapRegContainer pcc = cur.pcc();
    pcc.setAddress(cur.instAddr());
    return capEnforce(xc->tcBase(), capCheckBranch(pcc, target),
                      CHERI_CAPIDX_PCC, target);
}

// xRET and privileged CSR/SCR access require
// PCC.PERMIT_ACCESS_SYSTEM_REGISTERS (fault against PCC).
inline Fault
cheriCheckPccAsr(ExecContext *xc)
{
    const PCState &cur = xc->pcState().as<PCState>();
    if (capHasPerm(cur.pcc(), CHERIPerms::ASR))
        return NoFault;
    return capEnforce(xc->tcBase(),
                      CheriCapException::PermitAccessSystemRegistersViolation,
                      CHERI_CAPIDX_PCC);
}

// CHERI (Sail ext_check_CSR): CSRs above user level, and the user trap
// CSRs that have capability counterparts (utvec, uscratch, uepc), need
// PCC.PERMIT_ACCESS_SYSTEM_REGISTERS; the fault is reported against PCC.
inline Fault
cheriCheckCsrAccess(ExecContext *xc, uint64_t csr)
{
    if (bits(csr, 9, 8) == 0 && csr != 0x005 && csr != 0x040 &&
            csr != 0x041) {
        return NoFault;
    }
    return cheriCheckPccAsr(xc);
}

// Indirect jump through capability `target` (register `capIdx`) plus `imm`:
// CJALR / C.CJR / C.CJALR. Raises the capability exception if enforcing;
// otherwise installs the new PCC (sentries are unsealed) and PC, and, if
// `link` is non-null, returns the sentry return capability for `retAddr`.
// The PC state is written directly (to carry the new PCC), so the parser
// does not see an NPC write: callers must list IsControl themselves, or the
// pipelined CPUs never predict the jump.
inline Fault
cheriIndirectJump(ExecContext *xc, CapRegContainer target, int capIdx,
                  int64_t imm, Addr retAddr, CapRegContainer *link)
{
    if (Fault f = cheriCheckJump(xc->tcBase(), target, capIdx, imm))
        return f;
    const PCState &cur = xc->pcState().as<PCState>();
    if (!target.getTag()) {
        // Only reachable where violations are not raised (the kernel during
        // bring-up): keep going on the current PCC rather than adopting an
        // untagged, boundless one.
        warn_once("CHERI: jump through untagged c%d (addr %#x) tolerated "
                  "outside user mode\n", capIdx, target.getAddress());
        Addr a = target.getAddress();
        target = cur.pcc();
        target.setAddress(a);
    }
    Addr target_addr = (target.getAddress() + imm) & ~Addr(1);
    if (link)
        *link = capMakeSentryLink(cur.pcc(), retAddr);
    PCState next = cur;
    next.pcc(capJumpTargetPcc(target, target_addr));
    next.set(target_addr);
    next.npc(target_addr);
    xc->pcState(next);
    return NoFault;
}
} // namespace gem5::CHERIRiscvISAInst
}};
