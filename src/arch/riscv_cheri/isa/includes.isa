#include "arch/generic/cap_reg.hh"
#include "arch/generic/memhelpers.hh"
#include "arch/riscv_cheri/faults.hh"
#include "arch/riscv_cheri/fp_inst.hh"
#include "arch/riscv_cheri/mmu.hh"
#include "arch/riscv_cheri/reg_abi.hh"
#include "arch/riscv_cheri/regs/cap.hh"
#include "arch/riscv_cheri/regs/cc128_bounds.hh"
#include "arch/riscv_cheri/regs/float.hh"
#include "arch/riscv_cheri/regs/misc.hh"
#include "arch/riscv_cheri/regs/vector.hh"
#include "arch/riscv_cheri/utility.hh"
#include "base/condcodes.hh"
#include "cpu/base.hh"

// #include "cpu/simple/base.hh"
#include "cpu/exec_context.hh"
#include "cpu/exetrace.hh"
#include "cpu/simple/exec_context.hh"
#include "debug/CheriDecode.hh"
#include "debug/RiscvMisc.hh"
